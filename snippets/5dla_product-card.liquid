{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `article.product`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html). Not a
  wrapper around the legacy `product-grid-item` snippet (which dispatches
  to one of nine `settings.hover_style` includes) - kept independent per
  docs/revamp/collections/collection-basic-5dla-plan.md.

  Expects: product, swatch_limit
{%- endcomment -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

{%- assign badge_text = product.metafields.custom.badge_text.value -%}
{%- if badge_text == blank and product.available == false -%}
  {%- assign badge_text = 'products.product.sold_out' | t -%}
{%- elsif badge_text == blank and on_sale -%}
  {%- assign badge_text = 'products.general.sale_price' | t -%}
{%- endif -%}

{%- assign color_option = null -%}
{%- for option in product.options_with_values -%}
  {%- if option.name == 'Color' or option.name == 'Colour' -%}
    {%- assign color_option = option -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign short_description = product.metafields.custom.short_description.value
  | default: product.description
  | strip_html
  | truncatewords: 14
-%}

<article class="product">
  <div class="product-media">
    <a class="product-image" href="{{ product.url }}">
      {%- if badge_text != blank -%}
        <span class="badge">{{ badge_text }}</span>
      {%- endif -%}
      {%- if product.featured_media -%}
        <img
          src="{{ product.featured_media | image_url: width: 800 }}"
          alt="{{ product.featured_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="800"
          height="{{ 800 | divided_by: product.featured_media.preview_image.aspect_ratio }}"
        >
      {%- endif -%}
    </a>
    {%- comment -%}
      Not nested inside `a.product-image` (unlike the reference's single
      quick-add icon) - interactive buttons/forms can't sit inside another
      interactive element (the anchor) without breaking click handling, so
      this is a sibling positioned over the image instead. See
      snippets/5dla_product-card-actions.liquid.
    {%- endcomment -%}
    {%- render '5dla_product-card-actions', product: product -%}
  </div>
  <div class="product-copy">
    <div class="product-name">
      <a href="{{ product.url }}">{{ product.title }}</a>
      <span>
        {%- if on_sale -%}
          <del>{{ product.compare_at_price | money }}</del> {{ product.price | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>
    </div>
    {%- if short_description != blank -%}
      <p>{{ short_description }}</p>
    {%- endif -%}
    {%- if color_option -%}
      {%- assign current_variant = product.selected_or_first_available_variant -%}
      <div class="swatches wpb-variants-swatch" aria-label="Available product colours">
        {%- for value in color_option.values limit: swatch_limit -%}
          {%- render '5dla_product-swatch',
            product: product,
            option_position: color_option.position,
            value: value,
            is_first: forloop.first,
            current_variant: current_variant
          -%}
        {%- endfor -%}
        {%- if color_option.values.size > swatch_limit -%}
          <span class="color-count">+ {{ color_option.values.size | minus: swatch_limit }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
