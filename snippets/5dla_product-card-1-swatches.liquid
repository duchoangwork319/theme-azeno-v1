{%- comment -%}
  Color-swatch element (`.swatches` + `.swatch` spans + "+N" `.color-count`)
  for snippets/5dla_product-card-1.liquid.

  `wpb-variants-swatch` lives on the `.swatches` wrapper, not each swatch -
  sections/customer-variant.liquid emits `.wpb-variants-swatch
  {{ variant_name }}{...}` as a DESCENDANT selector, so the value class
  must be on a child, not the same element.

  Unlike card 3, every swatch past `swatch_limit` stays in the DOM
  (CSS-hidden via `.swatch--extra`) so "Show all colours"
  (client/ver_2_0/js/collection.js) can reveal them without a re-render.

  Expects: product, swatch_limit
{%- endcomment -%}

{%- liquid
  assign color_option = nil
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'Colour'
      assign color_option = option
      break
    endif
  endfor
-%}

{%- if color_option -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <div class="swatches wpb-variants-swatch" aria-label="Available product colours">
    {%- for value in color_option.values -%}
      {%- liquid
        assign active = ''
        if forloop.first
          assign active = ' active'
        endif

        assign extra = ''
        if forloop.index0 >= swatch_limit
          assign extra = ' swatch--extra'
        endif

        assign safe_value = value | escape | replace: '/', '-' | replace: ' ', '-'

        # Same cascading-availability computation as
        # snippets/5dla_product-card-3-swatches.liquid.
        assign option_key = 'option' | append: color_option.position
        assign option_disabled = true
        for variant in product.variants
          if variant.available and variant[option_key] == value
            assign matches_preceding = true
            for i in (1..color_option.position)
              if i != color_option.position
                assign prior_key = 'option' | append: i
                if variant[prior_key] != current_variant[prior_key]
                  assign matches_preceding = false
                endif
              endif
            endfor
            if matches_preceding
              assign option_disabled = false
              break
            endif
          endif
        endfor
      -%}
      <span
        class="swatch{{ active }}{{ extra }}{% if option_disabled %} disabled{% endif %} {{ value }} {{ safe_value }}"
        title="{{ value | strip | escape }}"
        data-variant="{{ value | strip | escape }}"
      ></span>
    {%- endfor -%}
    {%- if color_option.values.size > swatch_limit -%}
      <span class="color-count">+ {{ color_option.values.size | minus: swatch_limit }}</span>
    {%- endif -%}
  </div>
{%- endif -%}
