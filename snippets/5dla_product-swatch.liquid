{%- comment -%}
  Renders one product-card color swatch <span>. Ported from
  snippets/product-grid-hover-9.liquid L422-517 (active/value/safe_value/
  option_disabled attribute computation only - not the media-alt
  image-swatch branch). No inline background-color: swatch color/image is
  configured in sections/customer-variant.liquid (not touched here),
  which generates `.wpb-variants-swatch <value>{...}` CSS keyed by the
  same value/safe_value classes rendered below.

  Expects: product, option_position (color_option.position - NOT
  hardcoded to 1, since Color isn't guaranteed to be the product's first
  option), value, is_first, current_variant, index (0-based position in
  the values loop), swatch_limit

  `index >= swatch_limit` gets `swatch--extra`, hidden by default (see
  client/ver_2_0/scss/collection/_product-grid.scss) and revealed by
  toggling `body.show-all-colours` (client/ver_2_0/js/collection.js,
  bound to the "Show all colours" checkbox in
  sections/5dla_collection-filter-sort.liquid) - ports the reference's
  `a.swatches.slice(0, allColours ? void 0 : 4)` behavior, ie. all
  swatches are always in the DOM, just CSS-hidden past the limit.
{%- endcomment -%}

{% liquid
  assign active = ''
  if is_first
    assign active = ' active'
  endif

  assign extra = ''
  if index >= swatch_limit
    assign extra = ' swatch--extra'
  endif

  assign safe_value = value | escape | replace: '/', '-' | replace: ' ', '-'

  # A value is enabled only if some available variant carries it at this
  # option's position AND matches current_variant on every position before
  # it (cascading availability - e.g. a Size value is only enabled for the
  # currently selected Color). Generalizes the legacy snippet's three
  # hardcoded option_index branches via a computed `optionN` key.
  assign option_key = 'option' | append: option_position
  assign option_disabled = true
  for variant in product.variants
    if variant.available and variant[option_key] == value
      assign matches_preceding = true
      for i in (1..option_position)
        if i != option_position
          assign prior_key = 'option' | append: i
          if variant[prior_key] != current_variant[prior_key]
            assign matches_preceding = false
          endif
        endif
      endfor
      if matches_preceding
        assign option_disabled = false
        break
      endif
    endif
  endfor
%}

<span
  class="swatch{{ active }}{{ extra }}{% if option_disabled %} disabled{% endif %} {{ value }} {{ safe_value }}"
  title="{{ value | strip | escape }}"
  data-variant="{{ value | strip | escape }}"
></span>
