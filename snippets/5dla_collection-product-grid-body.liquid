{%- comment -%}
  Grid + load-more markup shared by both `paginate` branches in
  snippets/5dla_collection-product-grid-paginate.liquid.

  Expects `grid_collection`, `desktop_columns`, `desktop_max_width`,
  `desktop_padding`, `paginate` as render params. `section` is used
  directly (global, not passed) - tablet/mobile columns, display mode,
  and mobile padding/margin are read straight from `section.settings`
  too, same as `pagination_style`/`product_card_type` below.
{%- endcomment -%}

{%- liquid
  assign tablet_columns = section.settings.tablet_grid_item_count | at_least: 1
  assign mobile_columns = section.settings.mobile_grid_item_count | at_least: 1

  assign mobile_scroll_class = ''
  if section.settings.mobile_display_mode == 'scrollable'
    assign mobile_scroll_class = ' products--scroll'
  endif

  assign mobile_padding = section.settings.mobile_padding
  assign mobile_margin = section.settings.mobile_margin
-%}

{%- if grid_collection.products.size == 0 -%}
  <div class="empty-products">
    {{ 'collections.general.no_matches' | t }}
    <a href="{{ grid_collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
  </div>
{%- else -%}
  <section
    class="products{{ mobile_scroll_class }}"
    aria-label="{{ grid_collection.products_count }} {{ grid_collection.title }} products"
    style="--c5dla-grid-desktop-columns: {{ desktop_columns }}; --c5dla-grid-tablet-columns: {{ tablet_columns }}; --c5dla-grid-mobile-columns: {{ mobile_columns }}; --c5dla-grid-desktop-max-width: {{ desktop_max_width | escape }}; --c5dla-grid-desktop-padding: {{ desktop_padding | escape }}; --c5dla-grid-mobile-padding: {{ mobile_padding | escape }}; --c5dla-grid-mobile-margin: {{ mobile_margin | escape }};"
  >
    {%- for product in grid_collection.products -%}
      {% liquid
        if section.settings.product_card_type == 'card_1'
          render '5dla_product-card-1', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
        elsif section.settings.product_card_type == 'card_2'
          render '5dla_product-card-2', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
        elsif section.settings.product_card_type == 'card_3'
          render '5dla_product-card-3', product: product, swatch_limit: section.settings.swatch_limit, size_limit: section.settings.size_selector_limit, section: section, index: forloop.index
        elsif section.settings.product_card_type == 'card_4'
          render '5dla_product-card-4', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
        elsif section.settings.product_card_type == 'card_5'
          render '5dla_product-card-5', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
        elsif section.settings.product_card_type == 'card_6'
          render '5dla_product-card-6', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
        endif
      %}
    {%- endfor -%}
  </section>

  {%- if paginate.pages > 1 and paginate.next -%}
    <div
      class="c5dla-loadmore"
      data-c5dla-pagination
      data-section-id="{{ section.id }}"
      data-next-url="{{ paginate.next.url }}"
      data-pagination-style="{{ section.settings.pagination_style }}"
    >
      {%- if section.settings.pagination_style == 'loadmore' -%}
        <button type="button" class="btn btn-outline-dark" data-c5dla-loadmore>
          {{ 'collections.general.load_more' | t }}
        </button>
      {%- else -%}
        <div class="c5dla-loadmore__spinner" data-c5dla-infinite-sentinel aria-hidden="true"></div>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endif -%}
