{%- comment -%}
  BreadcrumbList JSON-LD for collection pages. Rendered from
  sections/header_fs.liquid (needs `section.blocks` - the Header FS megamenu
  blocks - to resolve where the current collection sits in the nav). Also
  read client-side by sections/collection-breadcrumb.liquid's
  `use_custom_hierarchy` option (via #json-ld-breadcrumbs).

  On the "all" collection itself: 1 item (Home) unless
  settings.show_shopall_breadcrumb is on, which adds it at position 2.

  Otherwise, max 4 items: Home > 1st collection > widget heading > 2nd
  collection.
    - 1st collection: a top-level link in linklists[main_menu].links that
      points at a collection - either the current collection itself, or the
      megamenu ancestor whose children link to it.
    - widget heading: only added when the current collection is found nested
      under a `main` widget block's menu_link_list_child, and that block also
      has its own `menu_link` set - the block's title/menu_link is inserted
      as an extra level between the 1st and 2nd collection.
    - 2nd collection: added when the current collection is found nested
      under that 1st collection's megamenu, via a `main` widget's
      menu_link_list_child or its own `menu_link`, or a block's
      spotlight_link.
{%- endcomment -%}
{%- liquid
  assign is_all_collection = false
  if collection.handle == 'all'
    assign is_all_collection = true
  endif

  assign main_menu = settings.menu_link_list
  assign first_collection_link = blank
  assign second_collection_matched = false
  assign widget_matched = false
  assign widget_title = blank
  assign widget_url = blank

  unless is_all_collection
    for main_menu_link in linklists[main_menu].links
      if first_collection_link == blank and main_menu_link.type == 'collection_link'
        if main_menu_link.object.handle == collection.handle
          assign first_collection_link = main_menu_link
        else
          assign megamenu_name = ''
          for block in section.blocks
            if second_collection_matched == false
              if block.type == 'megamenu'
                assign megamenu_name = block.settings.target_collection.handle
              elsif block.type == 'megamenu-child' and megamenu_name == main_menu_link.handle
                if block.settings.widget == 'main' and block.settings.menu_link != blank and block.settings.menu_link contains collection.url
                  assign second_collection_matched = true
                endif
                if second_collection_matched == false and block.settings.menu_link_list_child != blank
                  for link in linklists[block.settings.menu_link_list_child].links
                    if link.type == 'collection_link' and link.object.handle == collection.handle
                      assign second_collection_matched = true
                    endif
                    if link.type == 'collection_link' and link.object.handle == collection.handle and block.settings.widget == 'main' and block.settings.menu_link != blank
                      assign widget_matched = true
                      assign widget_title = block.settings.title
                      assign widget_url = block.settings.menu_link
                    endif
                  endfor
                endif
                if second_collection_matched == false and block.settings.spotlight_link != blank and block.settings.spotlight_link contains collection.url
                  assign second_collection_matched = true
                endif
              endif
            endif
          endfor
          if second_collection_matched
            assign first_collection_link = main_menu_link
          endif
        endif
      endif
    endfor

    assign level2_title = first_collection_link.title | default: collection.title
    assign level2_url = first_collection_link.url | default: collection.url

    assign level2_position = 2
    if settings.show_shopall_breadcrumb
      assign level2_position = 3
    endif
    assign next_position = level2_position | plus: 1
  endunless
-%}

<script type="application/ld+json" id="json-ld-breadcrumbs">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": {{ 'general.breadcrumbs.home_link_title' | t | json }},
        "item": {{ shop.url | json }}
      }
      {% if is_all_collection %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ collection.title | json }},
          "item": {{ shop.url | append: collection.url | json }}
        }
      {% else %}
        {% if settings.show_shopall_breadcrumb %},
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Products",
            "item": {{ shop.url | append: routes.all_products_collection_url | json }}
          }
        {% endif %},
        {
          "@type": "ListItem",
          "position": {{ level2_position }},
          "name": {{ level2_title | json }},
          "item": {{ shop.url | append: level2_url | json }}
        }
        {% if widget_matched %},
          {
            "@type": "ListItem",
            "position": {{ next_position }},
            "name": {{ widget_title | json }},
            "item": {{ shop.url | append: widget_url | json }}
          }
          {% assign next_position = next_position | plus: 1 %}
        {% endif %}
        {% if second_collection_matched %},
          {
            "@type": "ListItem",
            "position": {{ next_position }},
            "name": {{ collection.title | json }},
            "item": {{ shop.url | append: collection.url | json }}
          }
        {% endif %}
      {% endif %}
    ]
  }
</script>
