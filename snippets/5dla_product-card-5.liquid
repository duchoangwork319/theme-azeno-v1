{%- comment -%}
  Card variant 5 - ported from the reference's
  `article.compare-product-card`. `c5dla-card-5` scopes its CSS
  (client/ver_2_0/scss/collection/_product-card-5.scss).

  Data mapping (`.compare-product-copy`): p = product.vendor, h3 =
  product.title, price span/all anchors = current_variant.price/
  product.url. The image-overlay label ("THE CHAMPIONSHIP SUIT") is kept
  as the reference's own placeholder text - no real data source. Image =
  current_variant's, falling back to product.featured_media.

  `data-product-json`/`data-product-handle` on the root let
  client/ver_2_0/js/modules/quick-view.js read this product inline
  instead of fetching `/products/<handle>.js` (broken on a locale-
  prefixed storefront - see snippets/5dla_quick-view-modal.liquid).

  Expects: product, swatch_limit (unused - consistent render signature;
  no badge to override on this card), section, index
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
-%}

<article
  class="compare-product-card c5dla-card-5"
  data-product-json="{{ product | json | escape }}"
  data-product-handle="{{ product.handle | escape }}"
>
  <a class="compare-product-image" href="{{ product.url }}">
    {%- if current_media -%}
      {%- assign current_media_alt = current_media.alt | default: product.title -%}
      {%- render '5dla_product-card-media',
        media: current_media,
        alt: current_media_alt,
        width: 900,
        index: index,
        section: section
      -%}
    {%- endif -%}
    {%- comment -%} No label data source yet - dummy placeholder. {%- endcomment -%}
    <span>THE CHAMPIONSHIP SUIT</span>
  </a>
  <div class="compare-product-copy">
    <p>{{ product.vendor }}</p>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div>
      <span>{{ current_variant.price | money }}</span>
      <a href="{{ product.url }}">
        SHOP NOW
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14m-6-6 6 6-6 6"></path>
        </svg>
      </a>
    </div>
  </div>
</article>
