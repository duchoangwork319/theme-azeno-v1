{%- comment -%}
  Card variant 6 - ported from the reference's `article.other-tempo-card`
  (p/h3/a are direct children, no copy wrapper unlike card 5).
  `c5dla-card-6` scopes its CSS (client/ver_2_0/scss/collection/
  _product-card-6.scss).

  Data mapping: h3 = product.title, all anchors = product.url, p has no
  real data source (dummy placeholder). Image = current_variant's,
  falling back to product.featured_media.

  `data-product-json`/`data-product-handle` on the root let
  client/ver_2_0/js/modules/quick-view.js read this product inline
  instead of fetching `/products/<handle>.js` (broken on a locale-
  prefixed storefront - see snippets/5dla_quick-view-modal.liquid).

  Expects: product, swatch_limit (unused - consistent render signature;
  no badge to override on this card), section, index
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
-%}

<article
  class="other-tempo-card c5dla-card-6"
  data-product-json="{{ product | json | escape }}"
  data-product-handle="{{ product.handle | escape }}"
>
  <a class="other-tempo-image" href="{{ product.url }}">
    {%- if current_media -%}
      {%- assign current_media_alt = current_media.alt | default: product.title -%}
      {%- render '5dla_product-card-media',
        media: current_media,
        alt: current_media_alt,
        width: 800,
        index: index,
        section: section
      -%}
    {%- endif -%}
  </a>
  {%- comment -%} No category/eyebrow data source yet - dummy placeholder. {%- endcomment -%}
  <p>RACE-DAY ESSENTIAL</p>
  <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
  <a class="other-tempo-link" href="{{ product.url }}">
    VIEW PRODUCT
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14m-6-6 6 6-6 6"></path>
    </svg>
  </a>
</article>
