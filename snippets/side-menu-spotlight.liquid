{%- comment -%}
  Megamenu layout: side link column + main link columns + spotlight banner.
  Expects the calling scope (fs-menu.liquid) to provide `parent_menu_link`.
{%- endcomment -%}
<div class="megamenu-fs megamenu-fs--side-menu-spotlight">
  <div class="megamenu-fs__row">
    <ul class="megamenu-fs__side-col">
      {%- assign megamenu_name = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'megamenu' -%}
          {%- assign megamenu_name = block.settings.target_collection.handle -%}
        {%- elsif block.type == 'megamenu-child'
          and megamenu_name == parent_menu_link.handle
          and block.settings.widget == 'side'
        -%}
          {% render 'fs-megamenu', block: block %}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <ul class="megamenu-fs__main-cols">
      {%- assign megamenu_name = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'megamenu' -%}
          {%- assign megamenu_name = block.settings.target_collection.handle -%}
        {%- elsif block.type == 'megamenu-child'
          and megamenu_name == parent_menu_link.handle
          and block.settings.widget == 'main'
        -%}
          {% render 'fs-megamenu', block: block %}
        {%- endif -%}
      {%- endfor -%}
    </ul>
    {%- assign megamenu_name = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'megamenu' -%}
        {%- assign megamenu_name = block.settings.target_collection.handle -%}
      {%- elsif block.type == 'megamenu-child'
        and megamenu_name == parent_menu_link.handle
        and block.settings.widget == 'spotlight'
      -%}
        {% render 'fs-megamenu', block: block, spotlight_width: 25 %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
