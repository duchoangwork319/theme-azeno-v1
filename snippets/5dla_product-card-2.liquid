{%- comment -%}
  Card variant 2 - ported from the reference's `article.model-card`. No
  hover action group like card 1 - the always-visible `.model-shop-link`
  is the reference's own only action. `c5dla-card-2` scopes this variant's
  CSS (client/ver_2_0/scss/collection/_product-card-2.scss).

  Data mapping: model-image = current_variant's image, falling back to
  product.featured_media. model-badge = product.metafields.bwp_fields.
  badge_label (overridable by a `custom_badge` block - snippets/5dla_
  product-card-badge-override.liquid). model-headline = short_description
  metafield, falling back to product.description. model-features =
  product.metafields.bwp_fields.features (a list metafield, already a
  plain array - no `.value` needed). All blank-safe (render nothing if
  unset). `index`/`section` thread through to snippets/5dla_product-
  card-media.liquid for lazyload.

  Expects: product, swatch_limit (unused - consistent render signature
  across cards), section, index
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign model_image = current_variant.featured_image | default: product.featured_media
  assign badge_label = product.metafields.bwp_fields.badge_label
-%}

{%- capture badge_override_raw -%}
  {%- render '5dla_product-card-badge-override', product: product, section: section -%}
{%- endcapture -%}
{%- assign badge_override = badge_override_raw | strip | split: ';' -%}
{%- assign badge_override_label = badge_override[0] -%}
{%- assign badge_override_bg_color = badge_override[1] -%}
{%- assign badge_override_text_color = badge_override[2] -%}
{%- if badge_override_label != blank -%}
  {%- assign badge_label = badge_override_label -%}
{%- endif -%}

{%- assign short_description = product.metafields.custom.short_description.value
  | default: product.description
  | strip_html
  | truncatewords: 14
-%}

<article class="model-card c5dla-card-2">
  <div class="model-image-box">
    {%- if model_image -%}
      {%- assign model_image_alt = model_image.alt | default: product.title -%}
      {%- render '5dla_product-card-media',
        media: model_image,
        alt: model_image_alt,
        width: 960,
        index: index,
        section: section,
        extra_class: 'model-image'
      -%}
    {%- endif -%}
    {%- if badge_label != blank -%}
      <span class="model-badge" {% render '5dla_product-card-badge-style', bg_color: badge_override_bg_color, text_color: badge_override_text_color %}>{{ badge_label }}</span>
    {%- endif -%}
  </div>
  <div class="model-info">
    <div class="model-name-row">
      <h3 class="model-name">{{ product.title }}</h3>
      <span class="model-price">{{ current_variant.price | money }}</span>
    </div>
    {%- if short_description != blank -%}
      <p class="model-headline">{{ short_description }}</p>
    {%- endif -%}
    {%- if product.metafields.bwp_fields.features != blank -%}
      <div class="model-features">
        {%- for feature in product.metafields.bwp_fields.features.value -%}
          <span class="feature-pill text-uppercase">{{ feature }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <a class="model-shop-link" href="{{ product.url }}">
      Shop {{ product.title }}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
