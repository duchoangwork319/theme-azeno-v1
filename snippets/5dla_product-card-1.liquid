{%- comment -%}
  Card variant 1/3 (sections/5dla_collection-product-grid.liquid's
  `product_card_type` setting picks between 5dla_product-card-1/2/3).
  Ported 1:1 (markup + CSS) from the reference's `article.product`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html). Not a
  wrapper around the legacy `product-grid-item` snippet (which dispatches
  to one of nine `settings.hover_style` includes) - kept independent per
  docs/revamp/collections/collection-basic-5dla-plan.md.

  `c5dla-card-1` on the root element is this variant's CSS prefix (see
  client/ver_2_0/scss/collection/_product-grid.scss) - lets card-2/card-3
  reuse plain descendant class names (.product-image, .badge, etc.)
  without colliding with this variant's rules.

  Image: current_variant.featured_image, falling back to
  product.featured_media (same convention as card 2/3/4/5/6) - so the
  card shows the SELECTED variant's own image, not just the product's
  first/default one.

  Badge: product.metafields.custom.badge_text.value, falling back to
  "Sold out"/"Sale" text - ALL overridden (text only, same `.badge` UI) by
  a `custom_badge` block on `section` whose `product_list` includes
  this product. See snippets/5dla_product-card-badge-override.liquid.

  Expects: product, swatch_limit, section
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
-%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
{%- endif -%}

{%- assign badge_text = product.metafields.custom.badge_text.value -%}
{%- if badge_text == blank and product.available == false -%}
  {%- assign badge_text = 'products.product.sold_out' | t -%}
{%- elsif badge_text == blank and on_sale -%}
  {%- assign badge_text = 'products.general.sale_price' | t -%}
{%- endif -%}

{%- capture badge_override -%}
  {%- render '5dla_product-card-badge-override', product: product, section: section -%}
{%- endcapture -%}
{%- assign badge_override = badge_override | strip -%}
{%- if badge_override != blank -%}
  {%- assign badge_text = badge_override -%}
{%- endif -%}

{%- assign short_description = product.metafields.custom.short_description.value
  | default: product.description
  | strip_html
  | truncatewords: 14
-%}

<article class="product c5dla-card-1">
  <div class="product-media">
    <a class="product-image" href="{{ product.url }}">
      {%- if badge_text != blank -%}
        <span class="badge">{{ badge_text }}</span>
      {%- endif -%}
      {%- if current_media -%}
        <img
          src="{{ current_media | image_url: width: 800 }}"
          alt="{{ current_media.alt | default: product.title | escape }}"
          loading="lazy"
          width="800"
          height="{{ 800 | divided_by: current_media.aspect_ratio }}"
        >
      {%- endif -%}
    </a>
    {%- comment -%}
      Not nested inside `a.product-image` (unlike the reference's single
      quick-add icon) - interactive buttons/forms can't sit inside another
      interactive element (the anchor) without breaking click handling, so
      this is a sibling positioned over the image instead. See
      snippets/5dla_product-card-actions.liquid.
    {%- endcomment -%}
    {%- render '5dla_product-card-actions', product: product -%}
  </div>
  <div class="product-copy">
    <div class="product-name">
      <a href="{{ product.url }}">{{ product.title }}</a>
      <span>
        {%- if on_sale -%}
          <del>{{ product.compare_at_price | money }}</del> {{ product.price | money }}
        {%- else -%}
          {{ product.price | money }}
        {%- endif -%}
      </span>
    </div>
    {%- if short_description != blank -%}
      <p>{{ short_description }}</p>
    {%- endif -%}
    {%- render '5dla_product-card-1-swatches', product: product, swatch_limit: swatch_limit -%}
  </div>
</article>
