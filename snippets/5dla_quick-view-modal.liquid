{%- comment -%}
  Shared Quick View modal - ONE instance per page, rendered from
  layout/theme.liquid (not from sections/5dla_collection-product-grid.liquid,
  which can appear multiple times on one page - that would duplicate this
  markup's ids/aria wiring instead of sharing one dialog).

  Uses Bootstrap 5's own Modal component (already a project dependency)
  instead of a bespoke overlay/dialog - backdrop, Escape-to-close, scroll
  lock, and focus trap all come free; client/ver_2_0/js/modules/quick-
  view.js only calls `Modal.getOrCreateInstance(el).show()`/`.hide()`.

  Content layout is ported from the legacy quick view template
  (assets/wpbingo.js's `wpbingo.QuickView`) - same two-column shape, using
  Bootstrap's `.row`/`.col-*` grid instead of custom CSS. Image carousel
  uses Swiper instead of the legacy Slick, per request -
  `data-c5dla-quick-view-carousel`/`-carousel-wrapper`/`-prev`/`-next`
  below are a plain Swiper container/wrapper/nav shape (quick-view.js
  builds the slides and instantiates Swiper with Navigation + EffectFade).

  --- Adding a Quick View trigger to any snippets/5dla_product-card-*.liquid ---
  Any trigger element shaped like this works, no JS changes needed:

    <button type="button" class="quick-view-button" data-quick-view-trigger
      data-handle="{{ product.handle }}" data-variant-id="{{ current_variant.id }}">
      {{ 'products.product.quickview' | t }}
    </button>

  - `data-quick-view-trigger` is the only REQUIRED hook - quick-view.js
    delegates ONE document-level click listener for it (new/paginated
    cards work automatically, no re-init needed).
  - `data-handle` (required): quick-view.js fetches `/products/<handle>.js`
    to populate the modal and carousel.
  - `data-variant-id` (optional): preselects that variant - keep it live
    on variant change (see snippets/5dla_product-card-3.liquid's
    `dynamic="quick-view-trigger"`) if the card has its own picker.
  - If the trigger sits inside an element with `data-product-json` (card
    3's `[data-variant-picker]` root), quick-view.js reads that inline
    JSON instead of fetching - an optional optimization.
  - `class="quick-view-button"` is purely presentational.

  Everything inside `[data-c5dla-quick-view-content]` below is populated
  by quick-view.js at open time - this file only provides the static shell.
{%- endcomment -%}

<div
  class="modal c5dla-quick-view"
  id="c5dlaQuickViewModal"
  data-c5dla-quick-view
  tabindex="-1"
  aria-labelledby="c5dla-quick-view-title"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered modal-lg" data-c5dla-quick-view-dialog>
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="c5dla-quick-view-title" data-c5dla-quick-view-title></h2>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="{{ 'products.facets.close' | t }}"
        ></button>
      </div>

      <div class="modal-body">
        <div class="c5dla-quick-view__loading" data-c5dla-quick-view-loading hidden>
          Loading...
        </div>

        <div class="c5dla-quick-view__content row" data-c5dla-quick-view-content hidden>
          <div class="col-12 col-md-6 c5dla-quick-view__media img-quickview">
            <div class="c5dla-quick-view__carousel swiper" data-c5dla-quick-view-carousel>
              <div class="swiper-wrapper" data-c5dla-quick-view-carousel-wrapper></div>
              <button
                type="button"
                class="c5dla-quick-view__carousel-nav c5dla-quick-view__carousel-nav--prev"
                data-c5dla-quick-view-carousel-prev
                aria-label="{{ 'products.zoom.prev' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6"></path>
                </svg>
              </button>
              <button
                type="button"
                class="c5dla-quick-view__carousel-nav c5dla-quick-view__carousel-nav--next"
                data-c5dla-quick-view-carousel-next
                aria-label="{{ 'products.zoom.next' | t }}"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 18l6-6-6-6"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="col-12 col-md-6 c5dla-quick-view__info bwp-single-info">
            <a class="c5dla-quick-view__vendor" data-c5dla-quick-view-vendor href="#" hidden></a>
            <div class="c5dla-quick-view__price" data-c5dla-quick-view-price></div>

            <div class="c5dla-quick-view__options" data-c5dla-quick-view-options></div>

            <div
              class="c5dla-quick-view__available"
              data-c5dla-quick-view-available
              data-in-stock-label="{{ 'products.product.in_stock' | t }}"
              data-out-stock-label="{{ 'products.product.out_stock' | t }}"
            >
              <span data-c5dla-quick-view-available-text></span>
            </div>

            <form
              class="form-addtocart c5dla-quick-view__form"
              action="{{ routes.cart_add_url }}"
              method="post"
              enctype="multipart/form-data"
              data-product-form
              data-c5dla-quick-view-form
            >
              <input type="hidden" name="id" value="" data-c5dla-quick-view-variant-input>

              <div class="c5dla-quick-view__quantity" data-c5dla-quick-view-quantity>
                <label class="c5dla-quick-view__quantity-label">{{ 'products.product.quantity' | t }}</label>
                <div class="c5dla-quick-view__qty-selector">
                  <button
                    type="button"
                    class="c5dla-quick-view__qty-btn"
                    data-c5dla-quick-view-qty-minus
                    aria-label="{{ 'cart.general.reduce_quantity' | t }}"
                  >&minus;</button>
                  <input
                    type="number"
                    name="quantity"
                    min="1"
                    value="1"
                    inputmode="numeric"
                    class="c5dla-quick-view__qty-input"
                    data-c5dla-quick-view-qty-input
                  >
                  <button
                    type="button"
                    class="c5dla-quick-view__qty-btn"
                    data-c5dla-quick-view-qty-plus
                    aria-label="{{ 'cart.general.increase_quantity' | t }}"
                  >+</button>
                </div>
              </div>

              <button
                type="submit"
                class="js-btn-addtocart button product-action button-dark"
                data-c5dla-quick-view-submit
                data-add-to-cart-label="{{ 'products.product.add_to_cart' | t }}"
                data-sold-out-label="{{ 'products.product.sold_out' | t }}"
              >
                <span data-c5dla-quick-view-submit-label>{{ 'products.product.add_to_cart' | t }}</span>
              </button>
            </form>

            <a class="c5dla-quick-view__full-details" data-c5dla-quick-view-full-link href="#">
              {{ 'products.product.full_details' | t }}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
