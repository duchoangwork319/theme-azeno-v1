{%- comment -%}
  Add-to-cart for card variant 3. The reference just links to the product
  page; this is a real add-to-cart form reusing the legacy
  .form-addtocart/data-product-form AJAX hooks (assets/wpbingo.js's
  `formOverride`), same as card 1. `dynamic="variant-id-input"`/
  `"add-to-cart-button"` are kept pointed at the selected variant by
  client/ver_2_0/js/variant.js.

  Expects: product, current_variant
{%- endcomment -%}

{%- if product.available == false -%}
  <span class="button product-action button-dark" aria-disabled="true" style="opacity:0.5;pointer-events:none;">
    {{ 'products.product.sold_out' | t }}
  </span>
{%- else -%}
  <form
    action="{{ routes.cart_add_url }}"
    method="post"
    enctype="multipart/form-data"
    class="form-addtocart"
    data-product-form
  >
    <input type="hidden" name="id" value="{{ current_variant.id }}" dynamic="variant-id-input">
    <button
      type="submit"
      class="js-btn-addtocart button product-action button-dark"
      title="{{ 'products.product.add_to_cart' | t }}"
      dynamic="add-to-cart-button"
      {% unless current_variant.available %}disabled{% endunless %}
    >
      {{ 'products.product.add_to_cart' | t }}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </button>
  </form>
{%- endif -%}
