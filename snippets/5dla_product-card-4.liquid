{%- comment -%}
  Card variant 4 - ported from the reference's `article.essential-card`.
  `c5dla-card-4` scopes its CSS (client/ver_2_0/scss/collection/
  _product-card-4.scss).

  Data mapping: essential-image = current_variant's image, falling back
  to product.featured_media. store-product-badge = bwp_fields.badge_label
  (same metafield as card 2/3, overridable by a `custom_badge` block -
  snippets/5dla_product-card-badge-override.liquid). eyebrow/essential-
  copy have no real data source - dummy placeholder text. essential-price/
  essential-link (generic text in the reference) are mapped to
  current_variant.price/product.url instead, for consistency with other
  cards. `index`/`section` thread through to snippets/5dla_product-
  card-media.liquid for lazyload.

  Expects: product, swatch_limit (unused - consistent render signature
  across cards), section, index
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
  assign badge_label = product.metafields.bwp_fields.badge_label
-%}

{%- capture badge_override_raw -%}
  {%- render '5dla_product-card-badge-override', product: product, section: section -%}
{%- endcapture -%}
{%- assign badge_override = badge_override_raw | strip | split: ';' -%}
{%- assign badge_override_label = badge_override[0] -%}
{%- assign badge_override_bg_color = badge_override[1] -%}
{%- assign badge_override_text_color = badge_override[2] -%}
{%- if badge_override_label != blank -%}
  {%- assign badge_label = badge_override_label -%}
{%- endif -%}

<article class="essential-card c5dla-card-4">
  <a class="essential-image" href="{{ product.url }}">
    {%- if current_media -%}
      {%- assign current_media_alt = current_media.alt | default: product.title -%}
      {%- render '5dla_product-card-media',
        media: current_media,
        alt: current_media_alt,
        width: 900,
        index: index,
        section: section
      -%}
    {%- endif -%}
    {%- if badge_label != blank -%}
      <span class="store-product-badge" {% render '5dla_product-card-badge-style', bg_color: badge_override_bg_color, text_color: badge_override_text_color %}>{{ badge_label }}</span>
    {%- endif -%}
  </a>
  <div class="essential-info">
    {%- comment -%} No eyebrow data source yet - dummy placeholder. {%- endcomment -%}
    <p class="eyebrow">RACE-DAY ESSENTIAL</p>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- comment -%} No essential-copy data source yet - dummy placeholder. {%- endcomment -%}
    <p class="essential-copy">Dummy supporting copy for this product goes here.</p>
    <span class="essential-price">{{ current_variant.price | money }}</span>
    <a class="essential-link" href="{{ product.url }}">
      Shop {{ product.title }}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
