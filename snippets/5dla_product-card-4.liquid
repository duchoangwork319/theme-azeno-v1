{%- comment -%}
  Card variant 4/4 (sections/5dla_collection-product-grid.liquid's
  `product_card_type` setting picks between 5dla_product-card-1/2/3/4).
  Ported 1:1 (markup + CSS) from the reference's `article.essential-card`
  inside `section.essentials-section` (html/revamp-collection/rendered/
  Fusion Tri Suits for Hot-Weather Racing....html).

  `c5dla-card-4` on the root element is this variant's CSS prefix (see
  client/ver_2_0/scss/collection/_product-card-4.scss), same convention
  as card 1/2/3.

  Font: same reference page as card 2/3, same `--body: "Jost", Arial,
  sans-serif` - inherited from the scope-wide `:root` rule in
  client/ver_2_0/scss/collection/collection.scss (self-hosted from
  client/ver_2_0/fonts/Jost/static), not re-declared here.

  Data mapping (per request):
  - essential-image: current_variant.featured_image, falling back to
    product.featured_media (same convention as card 1/2/3/5/6) - shows the
    SELECTED variant's own image, not just the product's default one.
  - store-product-badge: product.metafields.bwp_fields.badge_label, same
    metafield used by card 2/3 (blank/no badge rendered if not set).
  - h3: product.title.
  - eyebrow: no data source specified - dummy placeholder text.
  - essential-copy: no data source specified - dummy placeholder text.
  - essential-price / essential-link (not in the mapping list, but part of
    "migrate article.essential-card") - the reference's own text is
    generic ("View price & availability" / "Find on 5DLA", not tied to a
    real product). Mapped here to current_variant.price and product.url
    for consistency with card 2/3's price/link handling, instead of
    kept as static text.

  store-product-badge is also overridden (text + optional background/text
  color, same markup) by a `custom_badge` block on `section` whose
  `product_list` includes this product - see
  snippets/5dla_product-card-badge-override.liquid.

  Expects: product, swatch_limit (unused here - kept for a consistent
  render signature with 5dla_product-card-1/2.liquid), section
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
  assign badge_label = product.metafields.bwp_fields.badge_label
-%}

{%- capture badge_override_json -%}
  {%- render '5dla_product-card-badge-override', product: product, section: section -%}
{%- endcapture -%}
{%- assign badge_override = badge_override_json | strip | parse_json -%}
{%- if badge_override.label != blank -%}
  {%- assign badge_label = badge_override.label -%}
{%- endif -%}

<article class="essential-card c5dla-card-4">
  <a class="essential-image" href="{{ product.url }}">
    {%- if current_media -%}
      <img
        src="{{ current_media | image_url: width: 900 }}"
        alt="{{ current_media.alt | default: product.title | escape }}"
        loading="lazy"
        width="900"
        height="{{ 900 | divided_by: current_media.aspect_ratio }}"
      >
    {%- endif -%}
    {%- if badge_label != blank -%}
      <span class="store-product-badge" {% render '5dla_product-card-badge-style', bg_color: badge_override.bg_color, text_color: badge_override.text_color %}>{{ badge_label }}</span>
    {%- endif -%}
  </a>
  <div class="essential-info">
    {%- comment -%} No eyebrow data source yet - dummy placeholder. {%- endcomment -%}
    <p class="eyebrow">RACE-DAY ESSENTIAL</p>
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- comment -%} No essential-copy data source yet - dummy placeholder. {%- endcomment -%}
    <p class="essential-copy">Dummy supporting copy for this product goes here.</p>
    <span class="essential-price">{{ current_variant.price | money }}</span>
    <a class="essential-link" href="{{ product.url }}">
      Shop {{ product.title }}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6"></path>
      </svg>
    </a>
  </div>
</article>
