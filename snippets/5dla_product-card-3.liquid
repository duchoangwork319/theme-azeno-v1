{%- comment -%}
  Card variant 3 - ported from the reference's `article.product-card`.
  `c5dla-card-3` scopes its CSS (client/ver_2_0/scss/collection/
  _product-card-3.scss).

  Data mapping notes: store-product-category links to the CURRENT
  collection (not "All"). store-product-vendor falls back to a
  best-effort `/pages/<handleized vendor>` guess (no real per-vendor page
  mapping specified). store-product-price/badge use VARIANT-level
  price/the bwp_fields.badge_label metafield, same as card 2. Swatches/
  size selector/add-to-cart are their own snippets (5dla_product-card-
  3-swatches / 5dla_product-size-selector / 5dla_product-card-3-actions).
  Review badge is temporarily hidden (commented out below).

  Variant switching (client/ver_2_0/js/variant.js): `data-variant-picker`
  + `data-current-variant-id` on the `<article>` are its entry point.
  Elements carrying `dynamic="<key>"` get updated in place on variant
  change instead of a full re-render: product-title (product-level, so a
  no-op today), product-price (formatted via assets/currencies.js's
  `Currency.formatMoney`), product-image (swapped ONLY on a COLOR change,
  never on size), and quick-view-trigger/variant-id-input (kept pointed
  at the selected variant). `data-product-json` on the `<article>` lets
  quick-view.js (snippets/5dla_quick-view-modal.liquid) read the live
  variant without a `/products/<handle>.js` fetch.

  Lazyload (snippets/5dla_product-card-media.liquid) and the variant-image
  hook above cooperate: client/ver_2_0/js/modules/variant-state.js's
  `updateProductImage` updates a pending `data-src` instead of forcing a
  real `src` on a still-deferred image.

  Expects: product, swatch_limit, size_limit, section, index
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign current_media = current_variant.featured_image | default: product.featured_media
  assign badge_label = product.metafields.bwp_fields.badge_label
  assign review_badge = product.metafields.judgeme.badge
-%}

{%- capture badge_override_raw -%}
  {%- render '5dla_product-card-badge-override', product: product, section: section -%}
{%- endcapture -%}
{%- assign badge_override = badge_override_raw | strip | split: ';' -%}
{%- assign badge_override_label = badge_override[0] -%}
{%- assign badge_override_bg_color = badge_override[1] -%}
{%- assign badge_override_text_color = badge_override[2] -%}
{%- if badge_override_label != blank -%}
  {%- assign badge_label = badge_override_label -%}
{%- endif -%}

<article
  class="product-card c5dla-card-3"
  data-product-json="{{ product | json | escape }}"
  data-product-handle="{{ product.handle | escape }}"
  data-variant-picker
  data-current-variant-id="{{ current_variant.id }}"
>
  <div class="product-image-box">
    {%- if current_media -%}
      {%- assign current_media_alt = current_media.alt | default: product.title -%}
      {%- render '5dla_product-card-media',
        media: current_media,
        alt: current_media_alt,
        width: 960,
        index: index,
        section: section,
        extra_attrs: 'dynamic="product-image"'
      -%}
    {%- endif -%}
    {%- if badge_label != blank -%}
      <span
        class="store-product-badge"
        {% render '5dla_product-card-badge-style',
          bg_color: badge_override_bg_color,
          text_color: badge_override_text_color
        %}
      >
        {{- badge_label -}}
      </span>
    {%- endif -%}
    <button
      class="quick-view-button"
      type="button"
      data-quick-view-trigger
      dynamic="quick-view-trigger"
      data-handle="{{ product.handle }}"
      data-variant-id="{{ current_variant.id }}"
    >
      {{ 'products.product.quickview' | t }}
    </button>
  </div>
  <div class="product-info">
    <a class="store-product-category" href="{{ collection.url }}">{{ collection.title }}</a>
    {% comment %} Hide the Review badge temporarily {% endcomment %}
    {% comment %}
      {%- if review_badge != blank -%}
        <span class="store-product-review jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
          {{ review_badge }}
        </span>
      {%- endif -%}
    {% endcomment %}
    <div class="product-title-row">
      <h3>
        <a href="{{ product.url }}"
          ><span dynamic="product-title">{{ product.title }}</span></a
        >
      </h3>
    </div>
    {%- if product.vendor != blank -%}
      {%- assign vendor_handle = product.vendor | handleize -%}
      <a class="store-product-vendor" href="{{ pages[vendor_handle].url | default: '#' }}">
        {{ product.vendor }}
      </a>
    {%- endif -%}
    <span class="store-product-price" dynamic="product-price">{{ current_variant.price | money }}</span>

    {%- render '5dla_product-card-3-swatches',
      product: product,
      swatch_limit: swatch_limit,
      current_variant: current_variant
    -%}

    {%- render '5dla_product-size-selector',
      product: product,
      current_variant: current_variant,
      size_limit: size_limit
    -%}
    {%- render '5dla_product-card-3-actions', product: product, current_variant: current_variant -%}
    <p class="availability-note">Confirm size and availability at checkout.</p>
  </div>
</article>
