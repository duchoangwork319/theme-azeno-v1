{%- comment -%}
  Left-side offcanvas filter & sort drawer (mirrored from the reference's
  right-side drawer - client/ver_2_0/scss/collection/_filter-sort.scss).
  Built fresh against native `collection`/`results.filters` - does NOT use
  the legacy `settings.filter_name_1`/snippets/filter-sidebar.liquid stack.

  `results` (required): the collection to build facets/sort for - only
  rendered when it's a real collection (not a manual `product_list`).

  `price_range_mode`: "text_box" (two number inputs) or "slider"
  (noUiSlider - client/ver_2_0/js/modules/price-range-slider.js), both
  submit the same `min_value`/`max_value` query params.

  `filter_list_mode` (list/boolean filters only): "column_checkbox"
  (2-col checkbox grid) or "pill_badge" (pills/swatches, checkbox visually
  hidden but still real so state survives closing without submitting -
  active look driven by `input:checked` + sibling CSS, not a server class).

  No "Apply" button - every field applies on its own `change`
  (client/ver_2_0/js/modules/filter-sort.js; the slider calls
  `form.requestSubmit()` instead). `data-prev-value` snapshots each
  field's rendered value so filter-sort.js can roll back an unsubmitted
  edit (mid-drag slider, focused-but-not-blurred input) when the drawer
  closes without submitting.

  Color pills reuse the sitewide `.wpb-variants-swatch {{ value }}`
  convention (sections/customer-variant.liquid emits the actual per-color
  CSS) - `.wpb-variants-swatch` on the `<label>`, the value class on the
  inner `&__swatch` span (a descendant selector, so they must be on
  different elements).

  Plain `<form>`, NOT `<facet-filters-form>` - that tag name is a global
  custom element (assets/facets.js) expecting the legacy filter-sidebar
  markup; reusing it would let that script hijack this form. All behavior
  is client/ver_2_0/js/modules/filter-sort.js instead.

  Every list/boolean `<label>` gets `title="{{ value.label }}"` regardless
  of mode - snippets/5dla_filter-sort-genders.liquid's gender quick-filter
  buttons locate a gender checkbox via that title attribute.

  `data-section-id` lets filter-sort.js re-fetch via `?sections=<id>` on
  Apply/Reset (same convention as collection.js's `loadNextPage`) instead
  of a real GET - though a real GET still works as a no-JS fallback, since
  `action`/`method`/field `name`s are all real.
{%- endcomment -%}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active = 0
  for filter in results.filters
    assign total_active = total_active | plus: filter.active_values.size
  endfor
-%}

<div class="c5dla-filter-overlay" data-c5dla-filter-overlay hidden></div>

<aside class="c5dla-filter-drawer" data-c5dla-filter-drawer hidden aria-hidden="true" aria-labelledby="c5dla-filter-drawer-title">
    <form id="c5dla-filter-form" method="get" action="{{ results.url }}" data-c5dla-filter-form data-section-id="{{ section.id }}">
      <div class="c5dla-filter-drawer__head">
        <h2 id="c5dla-filter-drawer-title">{{ 'products.facets.filter_and_sort' | t }}</h2>
        <button type="button" class="c5dla-filter-drawer__close" data-c5dla-filter-close aria-label="{{ 'products.facets.close' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>

      {%- if results.terms -%}
        <input type="hidden" name="q" value="{{ results.terms | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
      {%- endif -%}

      <div class="c5dla-filter-drawer__body">
        <div class="c5dla-filter-drawer__section">
          <h3>{{ 'products.facets.sort_by_label' | t }}</h3>
          <select name="sort_by" class="c5dla-filter-drawer__sort" data-c5dla-filter-sort data-prev-value="{{ sort_by }}">
            {%- for option in results.sort_options -%}
              <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>
                {{ option.name | escape }}
              </option>
            {%- endfor -%}
          </select>
        </div>

        {%- for filter in results.filters -%}
          {%- case filter.type -%}
            {%- when 'list', 'boolean' -%}
              {%- liquid
                assign is_color_filter = false
                if filter.param_name contains 'color' or filter.label == 'Color' or filter.label == 'Colour'
                  assign is_color_filter = true
                endif
              -%}
              <div class="c5dla-filter-drawer__section" filter-type="{{ filter.type }}" filter-label="{{ filter.label | escape }}">
                <h3>{{ filter.label | escape }}</h3>

                {%- if filter_list_mode == 'pill_badge' -%}
                  <div class="c5dla-filter-drawer__values c5dla-filter-drawer__values--pills{% if is_color_filter %} c5dla-filter-drawer__values--swatches wpb-variants-swatch{% endif %}">
                    {%- for value in filter.values -%}
                      {%- assign safe_value = value.value | escape | replace: '/', '-' | replace: ' ', '-' -%}
                      <label
                        class="c5dla-filter-drawer__pill{% if value.count == 0 and value.active == false %} is-disabled{% endif %}{% if is_color_filter %} c5dla-filter-drawer__pill--swatch{% endif %}"
                        title="{{ value.label | escape }}"
                      >
                        <input
                          type="checkbox"
                          class="c5dla-filter-drawer__pill-input"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          data-prev-value="{{ value.active }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        {%- if is_color_filter -%}
                          <span class="c5dla-filter-drawer__swatch {{ value.value }} {{ safe_value }}">
                            <span class="c5dla-filter-drawer__badge">{{ value.count }}</span>
                          </span>
                        {%- else -%}
                          <span class="c5dla-filter-drawer__pill-label">
                            {{ value.label | escape }}
                            <span class="c5dla-filter-drawer__badge">{{ value.count }}</span>
                          </span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="c5dla-filter-drawer__values c5dla-filter-drawer__values--grid">
                    {%- for value in filter.values -%}
                      <label
                        class="c5dla-filter-drawer__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}"
                        title="{{ value.label | escape }}"
                      >
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          data-prev-value="{{ value.active }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >
                        <span class="c5dla-filter-drawer__value-label">{{ value.label | escape }}</span>
                        <span class="c5dla-filter-drawer__count">({{ value.count }})</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- when 'price_range' -%}
              {%- liquid
                assign price_min_text = filter.min_value.value | money_without_currency | strip_html
                assign price_max_text = filter.max_value.value | money_without_currency | strip_html
                assign price_range_max_text = filter.range_max | money_without_currency | strip_html
                assign price_min_raw = filter.min_value.value | default: 0 | times: 1.0 | divided_by: 100.0
                assign price_max_raw = filter.max_value.value | default: filter.range_max | times: 1.0 | divided_by: 100.0
                assign price_range_max_raw = filter.range_max | times: 1.0 | divided_by: 100.0
              -%}
              <div class="c5dla-filter-drawer__section" filter-type="{{ filter.type }}">
                <h3>{{ filter.label | escape }}</h3>
                {%- if price_range_mode == 'slider' -%}
                  <div class="c5dla-filter-drawer__price-values">
                    <span data-c5dla-price-value-min>{{ price_min_text }}</span>
                    <span>—</span>
                    <span data-c5dla-price-value-max>{{ price_max_text }}</span>
                  </div>
                  <div
                    class="c5dla-filter-drawer__price-slider"
                    data-c5dla-price-slider
                    data-min="0"
                    data-max="{{ price_range_max_raw }}"
                    data-start-min="{{ price_min_raw }}"
                    data-start-max="{{ price_max_raw }}"
                  ></div>
                  <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" data-prev-value="{{ filter.min_value.value }}" data-c5dla-price-input-min>
                  <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" data-prev-value="{{ filter.max_value.value }}" data-c5dla-price-input-max>
                {%- else -%}
                  <div class="c5dla-filter-drawer__price">
                    <div class="c5dla-filter-drawer__price-field">
                      <label for="c5dla-filter-price-min">{{ 'products.facets.from' | t }}</label>
                      <input
                        type="number"
                        id="c5dla-filter-price-min"
                        name="{{ filter.min_value.param_name }}"
                        value="{{ price_min_text }}"
                        data-prev-value="{{ price_min_text }}"
                        placeholder="0"
                        min="0"
                        max="{{ price_range_max_text }}"
                      >
                    </div>
                    <div class="c5dla-filter-drawer__price-field">
                      <label for="c5dla-filter-price-max">{{ 'products.facets.to' | t }}</label>
                      <input
                        type="number"
                        id="c5dla-filter-price-max"
                        name="{{ filter.max_value.param_name }}"
                        value="{{ price_max_text }}"
                        data-prev-value="{{ price_max_text }}"
                        placeholder="{{ price_range_max_text }}"
                        min="0"
                        max="{{ price_range_max_text }}"
                      >
                    </div>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="c5dla-filter-drawer__foot{% if total_active == 0 %} no-reset{% endif %}">
        {%- if total_active > 0 -%}
          <a href="{{ results.url }}" class="c5dla-filter-drawer__reset" data-c5dla-filter-reset>
            {{ 'products.facets.reset' | t }}
          </a>
        {%- endif -%}
      </div>
    </form>
</aside>
