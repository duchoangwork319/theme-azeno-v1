{%- comment -%}
  Shared `<img>` renderer for every snippets/5dla_product-card-*.liquid's
  main product image - eager-vs-deferred lazyload decision lives here once.

  The `<span class="c5dla-media-wrap c5dla-skeleton">` wrapper (not the
  `<img>`) carries the skeleton/shimmer and is what's sized to match the
  eventual image - a `<img>` with no `src` at all (the deferred case) isn't
  reliably sized by width/height percentages in every browser, so
  `c5dla-media-wrap` just fills its already aspect-ratio'd parent instead.
  `c5dla-skeleton` is a single reusable class (client/ver_2_0/scss/
  collection/_product-grid.scss) - client/ver_2_0/js/modules/lazyload.js
  REMOVES it outright on `load`/`error`, which both stops the shimmer and
  reveals the `<img>` (hidden via `display:none` while the wrapper still
  has it).

  `index` <= `section.settings.start_image_lazyload_at` renders a real
  `src` + `loading="eager"`; everything else renders `data-src` instead
  (lazyload.js promotes it once scrolled near viewport). Blank `index`
  defaults to eager (fails safe).

  Expects: media, alt, width (int), index, section
  Optional: extra_attrs (raw HTML attribute string, e.g.
  `dynamic="product-image"` - caller-controlled, output unescaped),
  extra_class (extra class on the `<img>`, not the wrapper).
{%- endcomment -%}

{%- liquid
  assign lazyload_threshold = section.settings.start_image_lazyload_at | default: 4
  assign is_eager_image = true
  if index != blank and index > lazyload_threshold
    assign is_eager_image = false
  endif

  assign media_src = media | image_url: width: width
-%}
<span class="c5dla-media-wrap c5dla-skeleton">
  <img
    class="{{ extra_class }}"
    {{ extra_attrs }}
    {% if is_eager_image %}
      src="{{ media_src }}"
      loading="eager"
    {% else %}
      data-src="{{ media_src }}"
    {% endif %}
    alt="{{ alt | default: '' | escape }}"
    width="{{ width }}"
    height="{{ width | divided_by: media.aspect_ratio }}"
  >
</span>
