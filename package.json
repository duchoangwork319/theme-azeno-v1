{
  "name": "azeno-v1",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "bash scripts/build.sh",
    "dev:build:webpack": "npx webpack --config webpack.config.js",
    "prd:build:webpack": "npx webpack --config webpack.config.js --env prd",
    "dev:build:vite": "node scripts/vite-build.mjs --mode development",
    "prd:build:vite": "node scripts/vite-build.mjs --mode production",
    "build:gas": "node scripts/appsscript/build.mjs",
    "deploy:gas": "node scripts/appsscript/deploy.mjs",
    "lint": "npx eslint **/*.js",
    "lint:fix": "npx eslint **/*.js --fix",
    "theme": "bash scripts/theme-sync.sh",
    "prd:pull:theme": "bash scripts/theme-sync.sh pull prd theme",
    "prd:pull:data": "bash scripts/theme-sync.sh pull prd data",
    "prd:pull:blocks": "bash scripts/theme-sync.sh pull prd blocks",
    "prd:push:theme": "bash scripts/theme-sync.sh push prd theme",
    "prd:push:assets": "bash scripts/theme-sync.sh push prd assets",
    "dev:push:theme": "bash scripts/theme-sync.sh push dev theme",
    "dev:push:assets": "bash scripts/theme-sync.sh push dev assets",
    "dev:push:snippets": "bash scripts/theme-sync.sh push dev snippets",
    "login": "shopify auth login",
    "logout": "shopify auth logout"
  },
  "author": "DucHoang",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@google/clasp": "^3.3.0",
    "compressorjs": "^1.3.0",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@shopify/cli": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "cssnano": "^8.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "sass": "^1.94.1",
    "terser": "^5.50.0",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  },
  "workspaces": [
    "appsscript/dev.5dla",
    "appsscript/main.5dla"
  ]
}