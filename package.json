{
  "name": "azeno-v1",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "bash scripts/build.sh",
    "webpack:prd": "npx webpack --config webpack.config.js --env prd",
    "webpack:dev": "npx webpack --config webpack.config.js",
    "vite:prd": "node scripts/vite-build.mjs --mode production",
    "vite:dev": "node scripts/vite-build.mjs --mode development",
    "gas:build": "node scripts/appsscript/build.mjs",
    "logout": "shopify auth logout",
    "lint": "npx eslint **/*.js",
    "lint:fix": "npx eslint **/*.js --fix",
    "prd:pull": "dotenv -e ./.env/.env.prd -- bash -c 'shopify theme pull -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete --ignore package.json'",
    "prd:pulldata": "dotenv -e ./.env/.env.prd -- bash -c 'shopify theme pull -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete --only \"config/*\" \"templates/*\" \"locales/*\"'",
    "prd:pullblock": "dotenv -e ./.env/.env.prd -- bash -c 'shopify theme pull -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete' && git stash push ./blocks && git checkout -- . && git stash pop",
    "prd:push": "dotenv -e ./.env/.env.prd -- bash -c 'shopify theme push -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete'",
    "dev:push": "dotenv -e ./.env/.env.dev -- bash -c 'shopify theme push -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete -t $SHOPIFY_CLI_THEME_ID'",
    "dev:pushassets": "dotenv -e ./.env/.env.dev -- bash -c 'shopify theme push -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete --only \"assets/*\" -t $SHOPIFY_CLI_THEME_ID'",
    "dev:watch": "dotenv -e ./.env/.env.dev -- bash -c 'shopify theme dev -s $SHOPIFY_CLI_STORE_DOMAIN --password $SHOPIFY_CLI_THEME_TOKEN --nodelete --store-password $SHOPIFY_CLI_STOREFRONT_PWD -t $SHOPIFY_CLI_THEME_ID --theme-editor-sync'"
  },
  "author": "DucHoang",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "@google/clasp": "^3.3.0",
    "compressorjs": "^1.3.0",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@shopify/cli": "^4.6.1",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "cssnano": "^8.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "terser": "^5.50.0",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  },
  "workspaces": [
    "appsscript/dev.5dla",
    "appsscript/main.5dla"
  ]
}
