{%- comment -%}
  Ported from the reference's `nav.categories`. Its hardcoded category
  buttons were replaced with `activity_links` blocks (besides the "All"
  button) - not wired to real filtering yet (markup/CSS only - see docs/
  revamp/collections/collection-basic-5dla-plan.md §4.3).

  Block settings: `title` is a shared tooltip on every link in the block
  (not visible text - each link's own menu title is); `links` is a
  link_list, rendered in menu order; `collection_list` gates the whole
  block to specific collections (`| where` not `contains` - `contains`
  can't compare a Collection drop list against an object).

  A link bolds (`.active`, same as the "All" button) when it's a
  collection_link pointing at the currently-viewed collection. The
  `display:contents` <span> wrapper keeps `block.shopify_attributes` on a
  real node for the theme editor without breaking `.categories`' flex
  layout (`:is(button, a)` in _subcollections.scss styles both the "All"
  button and block links identically).
{%- endcomment -%}

{%- if section.settings.enable -%}
  <div class="c5dla-subcollections">
    <nav class="categories" aria-label="{{ collection.title | append: ' product categories' }}">
      {%- for block in section.blocks -%}
        {%- assign picked_collections = block.settings.collection_list | where: 'handle', collection.handle -%}
        {%- if block.type == 'activity_links' and picked_collections.size > 0 -%}
          <span style="display: contents;" {{ block.shopify_attributes }}>
            {%- for link in block.settings.links.links -%}
              {%- liquid
                assign is_current_collection = false
                if link.type == 'collection_link' and link.object.handle == collection.handle
                  assign is_current_collection = true
                endif
              -%}
              <a
                href="{{ link.url }}"
                class="{% if is_current_collection %}active{% endif %}"
                {% if block.settings.title != blank %}title="{{ block.settings.title | escape }}"{% endif %}
              >{{ link.title }}</a>
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Sub-collections",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "activity_links",
      "name": "Activity Links",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "links",
          "label": "Links"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "Show in Collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Sub-collections"
    }
  ]
}
{% endschema %}
