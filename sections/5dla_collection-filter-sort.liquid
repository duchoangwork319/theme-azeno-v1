{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `div.filters` inside
  `div.toolbar` (html/revamp-collection/rendered/Fusion Cycling Jerseys....html).
  Offcanvas/facets/form removed per request - raw HTML only, to see the
  exact UI first. Not wired to any real filtering/sorting/drawer yet - the
  "Filter & sorting" button and gender buttons are still inert. The
  "Show all colours" checkbox IS wired up (client/ver_2_0/js/collection.js
  toggles `body.show-all-colours`, see snippets/5dla_product-swatch.liquid).
  See docs/revamp/collections/collection-basic-5dla-plan.md §4.4.
{%- endcomment -%}

{%- if section.settings.enable -%}
  <div class="c5dla-toolbar">
    <div class="filters">
      <button class="filter-button" type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M7 12h10M10 17h4"></path>
        </svg>
        {{ 'products.facets.filter_and_sort' | t }}
      </button>

      <div class="genders">
        <button class="active" type="button">{{ 'products.facets.all' | t }} genders</button>
        <button type="button">Men</button>
        <button type="button">Women</button>
        <button type="button">Unisex</button>
      </div>

      <label class="colors-toggle">
        Show all colours
        <input type="checkbox" data-c5dla-colors-toggle>
        <span class="toggle-track"></span>
      </label>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Filter & Sort",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "5DLA Filter & Sort"
    }
  ]
}
{% endschema %}
