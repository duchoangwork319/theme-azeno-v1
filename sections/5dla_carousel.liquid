{%- comment -%}
  Ported from the reference's `section.five-hero` (html/revamp/homepage/
  5dla-homepage.html, aria-roledescription="carousel") - each
  `article.five-slide` is now a `promotion_banner` block instead of
  hardcoded markup.

  `#hero-pause` (the pause/play button) was intentionally not migrated -
  autoplay (client/ver_2_0/js/modules/carousel.js) only respects
  `prefers-reduced-motion` and still pauses on hover/focus/tab-hidden.

  A block gets the `five-finisher` class (extra offer/terms copy + its own
  layout - see client/ver_2_0/scss/homepage/_carousel.scss) whenever
  `five_finisher_offer` is filled in, since that's the only slide in the
  reference with that content, rather than a fixed position.

  `mobile_image` doubles as the tablet image (no separate tablet crop in
  the reference) - used for the `<picture><source>` below 650px, same
  cutoff the reference hardcoded for its own art-directed swap.

  No settings yet (only blocks) - this section is otherwise just a
  container for `promotion_banner` blocks, configured by hand in the
  Theme Editor.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="five-hero" aria-label="Featured collections" aria-roledescription="carousel">
    {%- for block in section.blocks -%}
      {%- assign is_active = forloop.first -%}
      {%- assign is_finisher = false -%}
      {%- if block.settings.five_finisher_offer != blank -%}
        {%- assign is_finisher = true -%}
      {%- endif -%}

      <article
        class="five-slide{% if is_active %} is-active{% endif %}{% if is_finisher %} five-finisher{% endif %}"
        aria-label="{{ forloop.index }} of {{ forloop.length }}: {{ block.settings.title | escape }}"
        {% unless is_active %}
          aria-hidden="true" inert
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.desktop_image != blank or block.settings.mobile_image != blank -%}
          <picture>
            {%- if block.settings.mobile_image != blank -%}
              <source media="(max-width: 650px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
            {%- endif -%}
            {% if block.settings.desktop_image != blank %}
              <img
                src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
                width="{{ block.settings.desktop_image.width }}"
                height="{{ block.settings.desktop_image.height }}"
                alt="{{ block.settings.desktop_image.alt | default: block.settings.title | escape }}"
                {% if is_active %}
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {% endif %}
          </picture>
        {%- endif -%}
        <div class="five-hero-shade"></div>
        <div class="five-hero-copy">
          {%- if block.settings.five_eyebrow != blank -%}
            <p class="five-eyebrow">{{ block.settings.five_eyebrow }}</p>
          {%- endif -%}
          {%- if block.settings.h2 != blank -%}
            <h2>{{ block.settings.h2 }}</h2>
          {%- endif -%}
          {%- if is_finisher -%}
            <p class="five-finisher-offer">{{ block.settings.five_finisher_offer }}</p>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="five-button" href="{{ block.settings.button_url | default: '#' }}">
              {{- block.settings.button_label }}
              <span>↗</span>
            </a>
          {%- endif -%}
          {%- if is_finisher and block.settings.five_finisher_terms != blank -%}
            <p class="five-finisher-terms">{{ block.settings.five_finisher_terms }}</p>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}

    {%- if section.blocks.size > 1 -%}
      <div class="five-hero-bottom">
        <div class="five-slide-tabs">
          {%- for block in section.blocks -%}
            <button
              aria-label="Show slide {{ forloop.index }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              data-slide="{{ forloop.index0 }}"
            >
              <span>{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span><i></i>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Carousel",
  "blocks": [
    {
      "type": "promotion_banner",
      "name": "Promotion Banner",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Internal name",
          "info": "For reference in the Theme Editor only - not shown on the storefront (used as this slide's accessible label)."
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile / tablet image"
        },
        {
          "type": "text",
          "id": "five_eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "h2",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "five_finisher_offer",
          "label": "Finisher offer",
          "info": "Only the finisher promo slide uses this - filling it in adds the finisher layout and styling to this slide."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "five_finisher_terms",
          "label": "Finisher terms",
          "info": "Only shown when Finisher offer is also filled in."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Carousel"
    }
  ]
}
{% endschema %}
