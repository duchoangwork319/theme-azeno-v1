{%- assign bg_image = section.settings.image -%}
{%- if section.blocks.size > 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.collection == collection.handle -%}
      {%- if block.settings.bgimage != blank -%}
        {%- assign bg_image = block.settings.bgimage -%}
        {%- assign is_collection = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if collection.handle != 'all' -%}
  {%- assign is_collection_page = true -%}
{%- endif -%}
{%- if section.settings.enable -%}
  {%- assign is_bg_image = section.settings.bgimage -%}
  {%- if is_bg_image or is_collection -%}
    {%- assign class_name = 'wpbingo-breadcrumbs--image' -%}
  {%- else -%}
    {%- assign class_name = 'wpbingo-breadcrumbs--no-image' -%}
  {%- endif -%}
  <section
    class="wpbingo-section--{{ section.id }} {{ section.settings.align_breadcrumb }} wpbingo-breadcrumbs {{ class_name }}{% if is_collection_page == blank %} have-collection{% endif %} {% if is_collection %} is_collection{% endif %}"
    style="--color-breadcrumb:{{ section.settings.color_breadcrumb }}"
  >
    <div
      class="wpbingo-breadcrumbs__image"
      {%- if is_bg_image or is_collection -%}
        style="background-image: url('{{ bg_image | image_url:width:bg_image.width,height:bg_image.height }}');background-size:cover; background-position:center center; {%- if section.settings.background_fixed -%}background-attachment: fixed;{%- endif -%}"
      {%- endif -%}
    >
      <div class="container">
        <div class="wpbingo-breadcrumbs__inner">
          {%- if section.settings.show_pagetitle -%}
            <h2 class="wpbingo-breadcrumbs__title">{{ collection.title }}</h2>
          {%- endif -%}
          {%- if section.settings.show_breadcrumb -%}
            {%- if section.settings.use_custom_hierarchy and settings.layout_header == 'fs' -%}
              {%- comment -%}
                Builds the breadcrumb from the BreadcrumbList JSON-LD generated
                by snippets/json-ld-collection.liquid (rendered from
                sections/header_fs.liquid) instead of the Liquid logic below.
              {%- endcomment -%}
              <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList"></ol>
              <script>
                (function () {
                  var jsonLdEl = document.getElementById('json-ld-breadcrumbs');
                  var target = document.currentScript.previousElementSibling;
                  if (!jsonLdEl || !target) return;
                  var data;
                  try {
                    data = JSON.parse(jsonLdEl.textContent);
                  } catch (e) {
                    return;
                  }
                  var items = (data && data.itemListElement) || [];

                  function esc(value) {
                    return String(value).replace(/[&<>"']/g, function (c) {
                      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                    });
                  }

                  var html = '';
                  items.forEach(function (item, index) {
                    var isLast = index === items.length - 1;
                    html +=
                      '<li class="breadcrumb__item' +
                      (isLast ? ' active' : '') +
                      '" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">';
                    if (isLast) {
                      html +=
                        '<span class="breadcrumb__text"><span itemprop="name">' + esc(item.name) + '</span></span>';
                    } else {
                      html +=
                        '<a class="breadcrumb__link" href="' +
                        esc(item.item) +
                        '" title="' +
                        esc(item.name) +
                        '" itemprop="item"><span itemprop="name">' +
                        esc(item.name) +
                        '</span></a>';
                    }
                    html += '<meta itemprop="position" content="' + item.position + '" /></li>';
                  });
                  target.innerHTML = html;
                })();
              </script>
            {%- else -%}
              <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList">
                <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
                  <a
                    class="breadcrumb__link"
                    href="/"
                    title="{{ 'general.breadcrumbs.home_link_title' | t }}"
                    itemprop="item"
                  >
                    <span itemprop="name">{{ 'general.breadcrumbs.home_link_title' | t }}</span>
                  </a>
                  <meta itemprop="position" content="1" />
                </li>
                {%- if collection.handle == 'all' -%}
                  {%- if settings.show_shopall_breadcrumb -%}
                    <li
                      class="breadcrumb__item active"
                      itemprop="itemListElement"
                      itemscope
                      itemtype="http://schema.org/ListItem"
                    >
                      <span class="breadcrumb__text">
                        <span itemprop="name">{{ collection.title }}</span>
                      </span>
                      <meta itemprop="position" content="2" />
                    </li>
                  {%- endif -%}
                {%- else -%}
                  <li
                    class="breadcrumb__item"
                    itemprop="itemListElement"
                    itemscope
                    itemtype="http://schema.org/ListItem"
                  >
                    <a
                      class="breadcrumb__link"
                      href="/collections/all"
                      title="{{ 'general.breadcrumbs.all_products_title' | t }}"
                      itemprop="item"
                    >
                      <span itemprop="name">{{ 'general.breadcrumbs.all_products_title' | t }}</span>
                    </a>
                    <meta itemprop="position" content="3" />
                  </li>
                  {%- if current_tags -%}
                    {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
                    <li
                      class="breadcrumb__item"
                      itemprop="itemListElement"
                      itemscope
                      itemtype="http://schema.org/ListItem"
                    >
                      <a class="breadcrumb__link" href="{{ url }}" title="{{ collection.title }}" itemprop="item">
                        <span itemprop="name">{{ collection.title }}</span>
                      </a>
                      <meta itemprop="position" content="3" />
                    </li>
                    <li
                      class="breadcrumb__item active"
                      itemprop="itemListElement"
                      itemscope
                      itemtype="http://schema.org/ListItem"
                    >
                      <span class="breadcrumb__text">
                        <span itemprop="name">{{ current_tags | join: ' + ' }}</span>
                      </span>
                      <meta itemprop="position" content="4" />
                    </li>
                  {%- else -%}
                    <li
                      class="breadcrumb__item active"
                      itemprop="itemListElement"
                      itemscope
                      itemtype="http://schema.org/ListItem"
                    >
                      <span class="breadcrumb__text">
                        <span itemprop="name">{{ collection.title }}</span>
                      </span>
                      <meta itemprop="position" content="3" />
                    </li>
                  {%- endif -%}
                {%- endif -%}
              </ol>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Collection Breadcrumb",
  "settings": [
    {
      "type": "header",
      "content": "Settings"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "bgimage",
      "label": "Use background image"
    },
    {
      "type": "checkbox",
      "id": "background_fixed",
      "label": "Background fixed",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image default",
      "info": "Default size: 1920x720 pixels"
    },
    {
      "type": "checkbox",
      "id": "show_pagetitle",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_custom_hierarchy",
      "label": "Use custom hierarchy",
      "default": false,
      "info": "Builds the breadcrumb from the BreadcrumbList JSON-LD generated by the Header FS section, instead of the logic above. Requires the Header FS header layout and Schema (JSON-LD) to be enabled."
    },
    {
      "type": "color",
      "id": "color_breadcrumb",
      "label": "Color breadcrumb",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "align_breadcrumb",
      "label": "Text align",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Background image",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "bgimage",
          "label": "Background image",
          "info": "Image will be used in this collection"
        }
      ]
    }
  ]
}
{% endschema %}
