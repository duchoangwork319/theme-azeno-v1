{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `h1` / `p.five-lead` /
  `nav.five-activity-links` inside `section.five-collection-intro`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html). The
  reference combines breadcrumb + heading + lead + links in ONE <section>;
  this theme splits breadcrumb into its own section
  (5dla_collection-breadcrumb.liquid per the plan's section list), so the
  reference's `.intro` wrapper padding is split across both sections
  instead (see _breadcrumb.scss/_banner.scss) rather than duplicated.

  The reference section has no image at all. `collection.description` can
  optionally embed its own `<img>` as its first element (added by the
  merchant in the collection's description field) - when present, it's
  rendered as an absolutely-positioned background behind the heading/lead/
  links (not a separate `image_picker` setting), and `has-banner-img` is
  added to the section so CSS can reserve space for it.
{%- endcomment -%}

{%- if section.settings.enable -%}
  {%- assign has_banner_img = false -%}
  {%- if collection.description contains '<img' -%}
    {%- assign has_banner_img = true -%}
  {%- endif -%}

  <section class="c5dla-banner{% if has_banner_img %} has-banner-img{% endif %}">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="five-lead">
        {{ collection.description }}
      </div>
    {%- endif -%}

    {%- comment -%}
      The reference's own hardcoded links (Cycling jerseys/Bib shorts/Road
      race suits/Triathlon/Running) were removed per request -
      `related_collection_links` blocks are now the only way to add
      entries to this nav. No maximum blocks, and no maximum links within
      a block's menu either - merchants can add as many as they want.
      Block settings:
      - title: optional, rendered as EVERY one of this block's links'
        `title` attribute (a shared tooltip) - NOT the visible text (each
        link's own `.title`, from the menu, is that).
      - links: a `link_list` (menu) - every link in it renders here, in
        menu order. A block only shows its links at all on collections
        picked in `collection_list` below.
      - collection_list: a `collection_list` setting (named to avoid
        shadowing the global `collections` Liquid object) - this block's
        links only render when the CURRENT collection is in this list.
        Checked via `| where: 'handle', collection.handle` (see the `for`
        loop below), not `collection_list contains collection` -
        `contains` only works for strings/numbers, not comparing a list
        of Collection drops against a Collection object.
      A link is bolded (`.active`, see
      client/ver_2_0/scss/collection/_banner.scss) when it's a collection
      link pointing at the collection page currently being viewed.

      Each block's links render inside a `display:contents` <span>
      carrying `block.shopify_attributes` - invisible to
      `.five-activity-links`' flex layout while still giving the theme
      editor one real DOM node per block to anchor its block-selection UI
      to.
    {%- endcomment -%}
    <nav class="five-activity-links" aria-label="{{ 'collections.general.catalog_title' | t }}">
      {%- for block in section.blocks -%}
        {%- assign picked_collections = block.settings.collection_list | where: 'handle', collection.handle -%}
        {%- if block.type == 'related_collection_links' and picked_collections.size > 0 -%}
          <span style="display: contents;" {{ block.shopify_attributes }}>
            {%- for link in block.settings.links.links -%}
              {%- liquid
                assign is_current_collection = false
                if link.type == 'collection_link' and link.object.handle == collection.handle
                  assign is_current_collection = true
                endif
              -%}
              <a
                href="{{ link.url }}"
                class="{% if is_current_collection %}active{% endif %}"
                {% if block.settings.title != blank %}title="{{ block.settings.title | escape }}"{% endif %}
              >{{ link.title }}</a>
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Collection Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "related_collection_links",
      "name": "Related Collection Links",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "links",
          "label": "Links"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "Show in Collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Collection Banner"
    }
  ]
}
{% endschema %}
