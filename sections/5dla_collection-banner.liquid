{%- comment -%}
  Ported from the reference's `h1`/`p.five-lead`/`nav.five-activity-links`
  (section.five-collection-intro). Breadcrumb is split into its own
  section here (5dla_collection-breadcrumb.liquid), so the reference's
  `.intro` padding is split across both (_breadcrumb.scss/_banner.scss).

  `collection.description` may embed its own `<img>` as its first element
  (merchant-authored) - rendered as an absolute background behind the
  heading/lead/links; `has-banner-img` lets CSS reserve space for it.
{%- endcomment -%}

{%- if section.settings.enable -%}
  {%- assign has_banner_img = false -%}
  {%- if collection.description contains '<img' -%}
    {%- assign has_banner_img = true -%}
  {%- endif -%}

  <section class="c5dla-banner{% if has_banner_img %} has-banner-img{% endif %}">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="five-lead">
        {{ collection.description }}
      </div>
    {%- endif -%}

    {%- comment -%}
      The reference's hardcoded links were replaced with
      `related_collection_links` blocks (no max blocks/links). Settings:
      `title` is a shared tooltip on every link in the block (not visible
      text - each link's own menu title is); `links` is a link_list,
      rendered in menu order; `collection_list` gates the whole block to
      specific collections (`| where` not `contains` - `contains` can't
      compare a Collection drop list against an object).

      A link bolds (`.active`) when it's a collection_link pointing at the
      currently-viewed collection. The `display:contents` <span> wrapper
      keeps `block.shopify_attributes` on a real node for the theme editor
      without breaking `.five-activity-links`' flex layout.
    {%- endcomment -%}
    <nav class="five-activity-links" aria-label="{{ 'collections.general.catalog_title' | t }}">
      {%- for block in section.blocks -%}
        {%- assign picked_collections = block.settings.collection_list | where: 'handle', collection.handle -%}
        {%- if block.type == 'related_collection_links' and picked_collections.size > 0 -%}
          <span style="display: contents;" {{ block.shopify_attributes }}>
            {%- for link in block.settings.links.links -%}
              {%- liquid
                assign is_current_collection = false
                if link.type == 'collection_link' and link.object.handle == collection.handle
                  assign is_current_collection = true
                endif
              -%}
              <a
                href="{{ link.url }}"
                class="{% if is_current_collection %}active{% endif %}"
                {% if block.settings.title != blank %}title="{{ block.settings.title | escape }}"{% endif %}
              >{{ link.title }}</a>
            {%- endfor -%}
          </span>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Collection Banner",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "related_collection_links",
      "name": "Related Collection Links",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "links",
          "label": "Links"
        },
        {
          "type": "collection_list",
          "id": "collection_list",
          "label": "Show in Collections"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Collection Banner"
    }
  ]
}
{% endschema %}
