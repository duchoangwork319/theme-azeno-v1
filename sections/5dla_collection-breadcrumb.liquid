{%- comment -%}
  Breadcrumb trail. Markup migrated from sections/collection-breadcrumb.liquid
  L40-91 (its BreadcrumbList `<ol>`, both variants) - `div.c5dla-breadcrumb`
  now wraps that `<ol>` instead of this section's old plain-text
  `p.c5dla-breadcrumb` ("Home / {{ collection.title }}").

  `use_custom_hierarchy` (new setting, same name as the legacy section's):
  ON reads the BreadcrumbList JSON-LD snippets/json-ld-collection.liquid
  renders into `#json-ld-breadcrumbs` (from sections/header_fs.liquid,
  sitewide on this theme) and builds the `<li>`s client-side - same inline
  script as the legacy section. OFF (default): the static trail (Home >
  All products/Collection > tags), same locale strings/logic as the
  legacy section. (The legacy section also gated this on
  `settings.layout_header == 'fs'` - omitted here since this section is
  theme-agnostic and that setting is always "fs" on this store anyway.)

  `home_label`/`separator`/`show_current` (this section's OLD settings)
  are gone - the migrated `<ol>` always shows "Home" via the
  `general.breadcrumbs.home_link_title` locale string, and always shows
  the current collection, same as the legacy section.
{%- endcomment -%}

{%- if section.settings.enable -%}
  <div class="c5dla-breadcrumb">
    {%- if section.settings.use_custom_hierarchy -%}
      <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList"></ol>
      <script>
        (function () {
          var jsonLdEl = document.getElementById('json-ld-breadcrumbs');
          var target = document.currentScript.previousElementSibling;
          if (!jsonLdEl || !target) return;
          var data;
          try {
            data = JSON.parse(jsonLdEl.textContent);
          } catch (e) {
            return;
          }
          var items = (data && data.itemListElement) || [];

          function esc(value) {
            return String(value).replace(/[&<>"']/g, function (c) {
              return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
            });
          }

          var html = '';
          items.forEach(function (item, index) {
            var isLast = index === items.length - 1;
            html +=
              '<li class="breadcrumb__item' +
              (isLast ? ' active' : '') +
              '" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">';
            if (isLast) {
              html += '<span class="breadcrumb__text"><span itemprop="name">' + esc(item.name) + '</span></span>';
            } else {
              html +=
                '<a class="breadcrumb__link" href="' +
                esc(item.item) +
                '" title="' +
                esc(item.name) +
                '" itemprop="item"><span itemprop="name">' +
                esc(item.name) +
                '</span></a>';
            }
            html += '<meta itemprop="position" content="' + item.position + '" /></li>';
          });
          target.innerHTML = html;
        })();
      </script>
    {%- else -%}
      <ol class="breadcrumb" itemscope itemtype="http://schema.org/BreadcrumbList">
        <li class="breadcrumb__item" itemprop="itemListElement" itemscope itemtype="http://schema.org/ListItem">
          <a
            class="breadcrumb__link"
            href="{{ routes.root_url }}"
            title="{{ 'general.breadcrumbs.home_link_title' | t }}"
            itemprop="item"
          >
            <span itemprop="name">{{ 'general.breadcrumbs.home_link_title' | t }}</span>
          </a>
          <meta itemprop="position" content="1" />
        </li>
        {%- if collection.handle == 'all' -%}
          {%- if settings.show_shopall_breadcrumb -%}
            <li
              class="breadcrumb__item active"
              itemprop="itemListElement"
              itemscope
              itemtype="http://schema.org/ListItem"
            >
              <span class="breadcrumb__text">
                <span itemprop="name">{{ collection.title }}</span>
              </span>
              <meta itemprop="position" content="2" />
            </li>
          {%- endif -%}
        {%- else -%}
          <li
            class="breadcrumb__item"
            itemprop="itemListElement"
            itemscope
            itemtype="http://schema.org/ListItem"
          >
            <a
              class="breadcrumb__link"
              href="{{ routes.all_products_collection_url }}"
              title="{{ 'general.breadcrumbs.all_products_title' | t }}"
              itemprop="item"
            >
              <span itemprop="name">{{ 'general.breadcrumbs.all_products_title' | t }}</span>
            </a>
            <meta itemprop="position" content="3" />
          </li>
          {%- if current_tags -%}
            <li
              class="breadcrumb__item"
              itemprop="itemListElement"
              itemscope
              itemtype="http://schema.org/ListItem"
            >
              <a
                class="breadcrumb__link"
                href="{{ routes.collections_url }}/{{ collection.handle }}"
                title="{{ collection.title }}"
                itemprop="item"
              >
                <span itemprop="name">{{ collection.title }}</span>
              </a>
              <meta itemprop="position" content="3" />
            </li>
            <li
              class="breadcrumb__item active"
              itemprop="itemListElement"
              itemscope
              itemtype="http://schema.org/ListItem"
            >
              <span class="breadcrumb__text">
                <span itemprop="name">{{ current_tags | join: ' + ' }}</span>
              </span>
              <meta itemprop="position" content="4" />
            </li>
          {%- else -%}
            <li
              class="breadcrumb__item active"
              itemprop="itemListElement"
              itemscope
              itemtype="http://schema.org/ListItem"
            >
              <span class="breadcrumb__text">
                <span itemprop="name">{{ collection.title }}</span>
              </span>
              <meta itemprop="position" content="3" />
            </li>
          {%- endif -%}
        {%- endif -%}
      </ol>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Breadcrumb",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "use_custom_hierarchy",
      "label": "Use custom hierarchy",
      "info": "Builds the trail from the site navigation structure (via the page's BreadcrumbList JSON-LD) instead of the default Home / All products / Collection / Tags trail.",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "5DLA Breadcrumb"
    }
  ]
}
{% endschema %}
