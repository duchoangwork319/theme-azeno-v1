{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `section.products`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html).
  Tablet/mobile stay fixed at 3/2 columns (not merchant-configurable);
  desktop column count is `desktop_grid_item_count`, passed to CSS via a
  custom property (see client/ver_2_0/scss/collection/_product-grid.scss).

  `product_card_type` picks which snippets/5dla_product-card-<N>.liquid
  renders each product - each one prefixes its own CSS under a matching
  `c5dla-card-<N>` class on its root element, so card variants never
  collide with each other's styling even while reusing the same plain
  class names (.product-image, .badge, etc.) internally.

  `pagination_style` is `loadmore` (button) or `infinite` (scroll
  sentinel) - both share the same `[data-c5dla-pagination]` container/
  Section Rendering API fetch-and-append in client/ver_2_0/js/collection.js,
  ported from assets/wpbingo.js's `ajaxFilterInfinity`.
{%- endcomment -%}

{%- liquid
  # type: "number" settings have no schema-level min/max (only "range"
  # does) - clamp here so an out-of-range value can't produce a
  # degenerate grid.
  assign desktop_columns = section.settings.desktop_grid_item_count | at_least: 3 | at_most: 5
-%}

{%- if section.settings.product_card_type == 'card_2' or section.settings.product_card_type == 'card_3' -%}
  {%- comment -%}
    5dla_product-card-2.liquid and 5dla_product-card-3.liquid both come
    from the same reference page and use its page-wide font (--body/
    --display: "Jost", Arial, sans-serif) - loaded once here (section-
    level), not per-card, to avoid duplicate <link> tags once per product
    in the loop below.
  {%- endcomment -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
{%- endif -%}

{%- paginate collection.products by section.settings.page_item -%}
  {%- if collection.products.size == 0 -%}
    <div class="empty-products">
      {{ 'collections.general.no_matches' | t }}
      <a href="{{ collection.url }}">{{ 'products.facets.clear_all' | t }}</a>
    </div>
  {%- else -%}
    <section
      class="products"
      aria-label="{{ collection.products_count }} {{ collection.title }} products"
      style="--c5dla-grid-desktop-columns: {{ desktop_columns }};"
    >
      {%- for product in collection.products -%}
        {% liquid
          if section.settings.product_card_type == 'card_1'
            render '5dla_product-card-1', product: product, swatch_limit: section.settings.swatch_limit
          elsif section.settings.product_card_type == 'card_2'
            render '5dla_product-card-2', product: product, swatch_limit: section.settings.swatch_limit
          elsif section.settings.product_card_type == 'card_3'
            render '5dla_product-card-3', product: product, swatch_limit: section.settings.swatch_limit, size_limit: section.settings.size_selector_limit
          endif
        %}
      {%- endfor -%}
    </section>

    {%- if paginate.pages > 1 and paginate.next -%}
      <div
        class="c5dla-loadmore"
        data-c5dla-pagination
        data-section-id="{{ section.id }}"
        data-next-url="{{ paginate.next.url }}"
        data-pagination-style="{{ section.settings.pagination_style }}"
      >
        {%- if section.settings.pagination_style == 'loadmore' -%}
          <button type="button" class="btn btn-outline-dark" data-c5dla-loadmore>
            {{ 'collections.general.load_more' | t }}
          </button>
        {%- else -%}
          <div class="c5dla-loadmore__spinner" data-c5dla-infinite-sentinel aria-hidden="true"></div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endpaginate -%}

{% schema %}
{
  "name": "5DLA Product Grid",
  "settings": [
    {
      "type": "select",
      "id": "product_card_type",
      "label": "Product card style",
      "options": [
        { "value": "card_1", "label": "Card 1" },
        { "value": "card_2", "label": "Card 2" },
        { "value": "card_3", "label": "Card 3" }
      ],
      "default": "card_1"
    },
    {
      "type": "number",
      "id": "desktop_grid_item_count",
      "label": "Columns (desktop)",
      "info": "3-5. Tablet/mobile are fixed at 3/2 columns.",
      "default": 4
    },
    {
      "type": "range",
      "id": "swatch_limit",
      "label": "Max swatches before \"+N\"",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "number",
      "id": "size_selector_limit",
      "label": "Max sizes before \"+N\" (card 3)",
      "default": 5
    },
    {
      "type": "range",
      "id": "page_item",
      "label": "Products per page",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        { "value": "loadmore", "label": "Load more button" },
        { "value": "infinite", "label": "Infinite scroll" }
      ],
      "default": "loadmore"
    }
  ],
  "presets": [
    {
      "name": "5DLA Product Grid"
    }
  ]
}
{% endschema %}
