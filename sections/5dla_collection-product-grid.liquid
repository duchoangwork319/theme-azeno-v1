{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `section.products`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html).
  Tablet/mobile stay fixed at 3/2 columns (not merchant-configurable);
  desktop column count is `desktop_grid_item_count`, passed to CSS via a
  custom property (see client/ver_2_0/scss/collection/_product-grid.scss).

  `product_card_type` picks which snippets/5dla_product-card-<N>.liquid
  renders each product - each one prefixes its own CSS under a matching
  `c5dla-card-<N>` class on its root element, so card variants never
  collide with each other's styling even while reusing the same plain
  class names (.product-image, .badge, etc.) internally.

  `pagination_style` is `loadmore` (button) or `infinite` (scroll
  sentinel) - both share the same `[data-c5dla-pagination]` container/
  Section Rendering API fetch-and-append in client/ver_2_0/js/collection.js,
  ported from assets/wpbingo.js's `ajaxFilterInfinity`.
{%- endcomment -%}

{%- liquid
  # type: "number" settings have no schema-level min/max (only "range"
  # does) - clamp here so an out-of-range value can't produce a
  # degenerate grid.
  assign desktop_columns = section.settings.desktop_grid_item_count | at_least: 3 | at_most: 5

  # `max_width` is free-form text (not "number"), so it can hold any valid
  # CSS length, e.g. `min(1270px, 100% - 104px)`, not just a bare px value -
  # passed straight through as the custom property's value.
  assign desktop_max_width = section.settings.max_width

  # Same reasoning as `max_width` - free-form `padding` shorthand text, not
  # split into 4 numeric settings, so e.g. percentage horizontal padding
  # (var(--c5dla-grid-desktop-padding), see
  # client/ver_2_0/scss/collection/_product-grid.scss) stays editable as-is
  # instead of being baked into `max_width`'s px value (which isn't
  # equivalent - percentage padding resolves against the containing
  # block's width on BOTH sides, not the box's own capped width).
  assign desktop_padding = section.settings.padding
-%}

{%- liquid
  assign product_list = section.settings.product_list
-%}
{%- if product_list and product_list.size > 0 -%}
  {%- paginate product_list by section.settings.page_item -%}
    <section
      class="products"
      aria-label="{{ product_list.size }} products"
      style="--c5dla-grid-desktop-columns: {{ desktop_columns }}; --c5dla-grid-desktop-max-width: {{ desktop_max_width | escape }}; --c5dla-grid-desktop-padding: {{ desktop_padding | escape }};"
    >
      {%- for product in product_list -%}
        {% liquid
          if section.settings.product_card_type == 'card_1'
            render '5dla_product-card-1', product: product, swatch_limit: section.settings.swatch_limit
          elsif section.settings.product_card_type == 'card_2'
            render '5dla_product-card-2', product: product, swatch_limit: section.settings.swatch_limit
          elsif section.settings.product_card_type == 'card_3'
            render '5dla_product-card-3', product: product, swatch_limit: section.settings.swatch_limit, size_limit: section.settings.size_selector_limit
          elsif section.settings.product_card_type == 'card_4'
            render '5dla_product-card-4', product: product, swatch_limit: section.settings.swatch_limit
          endif
        %}
      {%- endfor -%}
    </section>
    {{ paginate | default_pagination }}
  {%- endpaginate -%}
{%- elsif section.settings.collection != blank -%}
  {%- render '5dla_collection-product-grid-paginate',
    target_collection: section.settings.collection,
    desktop_columns: desktop_columns,
    desktop_max_width: desktop_max_width,
    desktop_padding: desktop_padding
  -%}
{%- elsif collection != blank -%}
  {%- render '5dla_collection-product-grid-paginate',
    target_collection: collection,
    desktop_columns: desktop_columns,
    desktop_max_width: desktop_max_width,
    desktop_padding: desktop_padding
  -%}
{%- else -%}
  <div class="empty-products">
    {{ 'collections.general.no_matches' | t }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "If set, paginates this collection instead of the page's own collection. Ignored if a product list is set below."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "If set, renders these products in full (no pagination) instead of a collection."
    },
    {
      "type": "select",
      "id": "product_card_type",
      "label": "Product card style",
      "options": [
        { "value": "card_1", "label": "Card 1" },
        { "value": "card_2", "label": "Card 2" },
        { "value": "card_3", "label": "Card 3" },
        { "value": "card_4", "label": "Card 4" }
      ],
      "default": "card_1"
    },
    {
      "type": "number",
      "id": "desktop_grid_item_count",
      "label": "Columns (desktop)",
      "info": "3-5. Tablet/mobile are fixed at 3/2 columns.",
      "default": 4
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width (desktop)",
      "info": "Any valid CSS length, e.g. 1600px or min(1270px, 100% - 104px). Desktop only - ignored on tablet/mobile.",
      "default": "1600px"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (desktop)",
      "info": "Any valid CSS padding shorthand, e.g. 0 5.15% 85px. Desktop only - tablet/mobile keep their own fixed padding.",
      "default": "0 5.15% 85px"
    },
    {
      "type": "range",
      "id": "swatch_limit",
      "label": "Max swatches before \"+N\"",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "number",
      "id": "size_selector_limit",
      "label": "Max sizes before \"+N\" (card 3)",
      "default": 5
    },
    {
      "type": "range",
      "id": "page_item",
      "label": "Products per page",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        { "value": "loadmore", "label": "Load more button" },
        { "value": "infinite", "label": "Infinite scroll" }
      ],
      "default": "loadmore"
    }
  ],
  "presets": [
    {
      "name": "5DLA Product Grid"
    }
  ]
}
{% endschema %}
