{%- comment -%}
  Ported 1:1 (markup + CSS) from the reference's `section.products`
  (html/revamp-collection/rendered/Fusion Cycling Jerseys....html).
  Column counts (`desktop_grid_item_count`/`tablet_grid_item_count`/
  `mobile_grid_item_count`) are all merchant-configurable, passed to CSS via
  custom properties (see client/ver_2_0/scss/collection/_product-grid.scss).

  `mobile_display_mode`: "grid" (default - the grid above, just at
  `mobile_grid_item_count` columns) or "scrollable", which switches
  `.products` to a horizontally-scrolling flex row at the <=720px
  breakpoint ONLY (tablet/desktop are never affected) - ports the
  reference's own mobile `.model-grid` behavior (html/revamp-collection/
  rendered/Fusion Tri Suits for Hot-Weather Racing _ 5DLA Asia.html,
  ~L1969-1981: `display:flex`/`overflow-x:auto`/`scroll-snap-type:x
  mandatory` + each card `flex: 0 0 72vw`/`scroll-snap-align:start`). Applied
  via the `.products--scroll` modifier class, set from this setting in both
  this section's own `product_list` branch below AND
  snippets/5dla_collection-product-grid-body.liquid (the other place
  `.products` gets rendered, for the `collection`-driven branches) - that
  snippet reads `section.settings.mobile_display_mode` directly rather than
  this being threaded through snippets/5dla_collection-product-grid-paginate.liquid
  as a render param, same as how it already reads `pagination_style`/
  `product_card_type` directly (see its own top comment: "`section` is used
  directly (global object, not passed)").

  `product_card_type` picks which snippets/5dla_product-card-<N>.liquid
  renders each product - each one prefixes its own CSS under a matching
  `c5dla-card-<N>` class on its root element, so card variants never
  collide with each other's styling even while reusing the same plain
  class names (.product-image, .badge, etc.) internally.

  `pagination_style` is `loadmore` (button) or `infinite` (scroll
  sentinel) - both share the same `[data-c5dla-pagination]` container/
  Section Rendering API fetch-and-append in client/ver_2_0/js/collection.js,
  ported from assets/wpbingo.js's `ajaxFilterInfinity`.

  `custom_badge` blocks: NOT rendered as links anywhere in this section
  (unrelated to sections/5dla_collection-subcollections.liquid's/
  5dla_collection-banner.liquid's own `activity_link`/
  `related_collection_link` blocks) - a badge TEXT override instead. See
  snippets/5dla_product-card-badge-override.liquid for the full mechanics;
  `section` is passed to every snippets/5dla_product-card-*.liquid render
  call below (and in snippets/5dla_collection-product-grid-body.liquid) so
  those snippets can check this section's blocks against the product
  they're rendering.
{%- endcomment -%}

{%- liquid
  # type: "number" settings have no schema-level min/max (only "range"
  # does) - clamp here so an out-of-range value can't produce a
  # degenerate grid.
  assign desktop_columns = section.settings.desktop_grid_item_count | at_least: 3 | at_most: 5
  assign tablet_columns = section.settings.tablet_grid_item_count | at_least: 1
  assign mobile_columns = section.settings.mobile_grid_item_count | at_least: 1

  assign mobile_scroll_class = ''
  if section.settings.mobile_display_mode == 'scrollable'
    assign mobile_scroll_class = ' products--scroll'
  endif

  # Free-form text (not split into numeric settings), same reasoning as
  # `padding` below - passed straight through as each custom property's
  # value. Only read at the <=720px breakpoint (client/ver_2_0/scss/
  # collection/_product-grid.scss); `mobile_margin` is overridden by
  # `.products--scroll`'s own fixed margin when `mobile_display_mode` is
  # "scrollable" (that spacing is tied to the horizontal-scroll layout
  # itself, not merchant-configurable).
  assign mobile_padding = section.settings.mobile_padding
  assign mobile_margin = section.settings.mobile_margin

  # `max_width` is free-form text (not "number"), so it can hold any valid
  # CSS length, e.g. `min(1270px, 100% - 104px)`, not just a bare px value -
  # passed straight through as the custom property's value.
  assign desktop_max_width = section.settings.max_width

  # Same reasoning as `max_width` - free-form `padding` shorthand text, not
  # split into 4 numeric settings, so e.g. percentage horizontal padding
  # (var(--c5dla-grid-desktop-padding), see
  # client/ver_2_0/scss/collection/_product-grid.scss) stays editable as-is
  # instead of being baked into `max_width`'s px value (which isn't
  # equivalent - percentage padding resolves against the containing
  # block's width on BOTH sides, not the box's own capped width).
  assign desktop_padding = section.settings.padding
-%}

{%- liquid
  assign product_list = section.settings.product_list
-%}

{%- comment -%}
  Filter & sort panel (merged from sections/5dla_collection-filter-sort.liquid,
  then given a real offcanvas drawer - see snippets/5dla_filter-sort-drawer.liquid):
  only works against a real collection (`collection` or
  `section.settings.collection`) since it drives collection filtering/sorting -
  it has no meaning when `product_list` is set, so it's suppressed in that case.
{%- endcomment -%}
{%- liquid
  assign filter_collection = section.settings.collection | default: collection
-%}
{%- if section.settings.filter_sort_enable and product_list == blank and filter_collection != blank -%}
  <div class="c5dla-toolbar">
    <div class="filters">
      <button class="filter-button" type="button" data-c5dla-filter-toggle aria-haspopup="dialog" aria-expanded="false" aria-controls="c5dla-filter-form">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7h16M7 12h10M10 17h4"></path>
        </svg>
        {{ 'products.facets.filter_and_sort' | t }}
      </button>

      {%- render '5dla_filter-sort-genders', results: filter_collection -%}

      <label class="colors-toggle">
        Show all colours
        <input type="checkbox" data-c5dla-colors-toggle>
        <span class="toggle-track"></span>
      </label>
    </div>
  </div>

  {%- render '5dla_filter-sort-drawer',
    results: filter_collection,
    price_range_mode: section.settings.price_range_mode,
    filter_list_mode: section.settings.filter_list_mode
  -%}
{%- endif -%}

{%- if product_list and product_list.size > 0 -%}
  {%- paginate product_list by section.settings.page_item -%}
    <section
      class="products{{ mobile_scroll_class }}"
      aria-label="{{ product_list.size }} products"
      style="--c5dla-grid-desktop-columns: {{ desktop_columns }}; --c5dla-grid-tablet-columns: {{ tablet_columns }}; --c5dla-grid-mobile-columns: {{ mobile_columns }}; --c5dla-grid-desktop-max-width: {{ desktop_max_width | escape }}; --c5dla-grid-desktop-padding: {{ desktop_padding | escape }}; --c5dla-grid-mobile-padding: {{ mobile_padding | escape }}; --c5dla-grid-mobile-margin: {{ mobile_margin | escape }};"
    >
      {%- for product in product_list -%}
        {% liquid
          if section.settings.product_card_type == 'card_1'
            render '5dla_product-card-1', product: product, swatch_limit: section.settings.swatch_limit, section: section
          elsif section.settings.product_card_type == 'card_2'
            render '5dla_product-card-2', product: product, swatch_limit: section.settings.swatch_limit, section: section
          elsif section.settings.product_card_type == 'card_3'
            render '5dla_product-card-3', product: product, swatch_limit: section.settings.swatch_limit, size_limit: section.settings.size_selector_limit, section: section
          elsif section.settings.product_card_type == 'card_4'
            render '5dla_product-card-4', product: product, swatch_limit: section.settings.swatch_limit, section: section
          elsif section.settings.product_card_type == 'card_5'
            render '5dla_product-card-5', product: product, swatch_limit: section.settings.swatch_limit, section: section
          elsif section.settings.product_card_type == 'card_6'
            render '5dla_product-card-6', product: product, swatch_limit: section.settings.swatch_limit, section: section
          endif
        %}
      {%- endfor -%}
    </section>
    {{ paginate | default_pagination }}
  {%- endpaginate -%}
{%- elsif section.settings.collection != blank -%}
  {%- render '5dla_collection-product-grid-paginate',
    target_collection: section.settings.collection,
    desktop_columns: desktop_columns,
    desktop_max_width: desktop_max_width,
    desktop_padding: desktop_padding
  -%}
{%- elsif collection != blank -%}
  {%- render '5dla_collection-product-grid-paginate',
    target_collection: collection,
    desktop_columns: desktop_columns,
    desktop_max_width: desktop_max_width,
    desktop_padding: desktop_padding
  -%}
{%- else -%}
  <div class="empty-products">
    {{ 'collections.general.no_matches' | t }}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "5DLA Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "If set, paginates this collection instead of the page's own collection. Ignored if a product list is set below."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "If set, renders these products in full (no pagination) instead of a collection."
    },
    {
      "type": "select",
      "id": "product_card_type",
      "label": "Product card style",
      "options": [
        { "value": "card_1", "label": "Card 1" },
        { "value": "card_2", "label": "Card 2" },
        { "value": "card_3", "label": "Card 3" },
        { "value": "card_4", "label": "Card 4" },
        { "value": "card_5", "label": "Card 5" },
        { "value": "card_6", "label": "Card 6" }
      ],
      "default": "card_1"
    },
    {
      "type": "select",
      "id": "mobile_display_mode",
      "label": "Display Mode (mobile)",
      "info": "Scrollable swaps the mobile grid for a horizontally-scrolling row, one card at a time.",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scrollable", "label": "Scrollable" }
      ],
      "default": "grid"
    },
    {
      "type": "number",
      "id": "desktop_grid_item_count",
      "label": "Columns (desktop)",
      "info": "3-5.",
      "default": 4
    },
    {
      "type": "number",
      "id": "tablet_grid_item_count",
      "label": "Columns (tablet)",
      "default": 3
    },
    {
      "type": "number",
      "id": "mobile_grid_item_count",
      "label": "Columns (mobile)",
      "info": "Ignored when Display Mode (mobile) above is Scrollable.",
      "default": 2
    },
    {
      "type": "text",
      "id": "mobile_padding",
      "label": "Padding (mobile)",
      "info": "Any valid CSS padding shorthand, e.g. 0 9px 53px.",
      "default": "0 9px 53px"
    },
    {
      "type": "text",
      "id": "mobile_margin",
      "label": "Margin (mobile)",
      "info": "Any valid CSS margin shorthand, e.g. 0 auto. Ignored when Display Mode (mobile) above is Scrollable (that layout keeps its own fixed margin).",
      "default": "0 auto"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width (desktop)",
      "info": "Any valid CSS length, e.g. 1600px or min(1270px, 100% - 104px). Desktop only - ignored on tablet/mobile.",
      "default": "1600px"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (desktop)",
      "info": "Any valid CSS padding shorthand, e.g. 0 5.15% 85px. Desktop only - tablet/mobile keep their own fixed padding.",
      "default": "0 5.15% 85px"
    },
    {
      "type": "range",
      "id": "swatch_limit",
      "label": "Max swatches before \"+N\"",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "number",
      "id": "size_selector_limit",
      "label": "Max sizes before \"+N\" (card 3)",
      "default": 5
    },
    {
      "type": "range",
      "id": "page_item",
      "label": "Products per page",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        { "value": "loadmore", "label": "Load more button" },
        { "value": "infinite", "label": "Infinite scroll" }
      ],
      "default": "loadmore"
    },
    {
      "type": "header",
      "content": "Filter & Sort"
    },
    {
      "type": "checkbox",
      "id": "filter_sort_enable",
      "label": "Enable filter & sort panel",
      "info": "Only works with a collection (Collection setting above, or the page's own collection) - ignored when Products above is set.",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_list_mode",
      "label": "Filter List Mode",
      "info": "Only applies to list/boolean filters (e.g. Size, Gender, Availability, Color) - ignored by the Price filter.",
      "options": [
        { "value": "column_checkbox", "label": "Column & Checkbox" },
        { "value": "pill_badge", "label": "Pill & Badge" }
      ],
      "default": "column_checkbox"
    },
    {
      "type": "select",
      "id": "price_range_mode",
      "label": "Price Range Mode",
      "options": [
        { "value": "text_box", "label": "Text Box" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "text_box"
    }
  ],
  "blocks": [
    {
      "type": "custom_badge",
      "name": "Custom Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "bg_color",
          "label": "Background color",
          "info": "Hex color, e.g. #fffffff5 (supports 8-digit hex with alpha - the \"color\" setting type doesn't)."
        },
        {
          "type": "text",
          "id": "text_color",
          "label": "Text color",
          "info": "Hex color, e.g. #fffffff5 (supports 8-digit hex with alpha - the \"color\" setting type doesn't)."
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Show in Products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Product Grid"
    }
  ]
}
{% endschema %}
