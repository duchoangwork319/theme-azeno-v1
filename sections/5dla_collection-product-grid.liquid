{%- comment -%}
  Ported from the reference's `section.products`. Column counts are
  merchant-configurable, passed to CSS via custom properties (client/
  ver_2_0/scss/collection/_product-grid.scss).

  `mobile_display_mode: "scrollable"` swaps `.products` for a horizontally-
  scrolling flex row at <=720px only (`.products--scroll`, ported from the
  reference's mobile `.model-grid`) - set here AND in snippets/5dla_
  collection-product-grid-body.liquid (reads `section.settings` directly
  rather than threading it through as a render param, like pagination_style/
  product_card_type).

  `product_card_type` picks which snippets/5dla_product-card-<N>.liquid
  renders each product (each scoped under its own `c5dla-card-<N>` class).

  `pagination_style` (loadmore/infinite) shares `[data-c5dla-pagination]` +
  the Section Rendering API fetch-and-append in client/ver_2_0/js/
  collection.js (ported from assets/wpbingo.js's `ajaxFilterInfinity`).

  `custom_badge` blocks override a card's badge TEXT only (not a link type -
  see snippets/5dla_product-card-badge-override.liquid); `section` is
  passed to every card render call so they can check their own product
  against this section's blocks.

  `index: forloop.index` (1-based) is passed the same way, for each card to
  compare against `start_image_lazyload_at` (eager vs. deferred image
  loading - see client/ver_2_0/js/modules/lazyload.js).
{%- endcomment -%}

{%- liquid
  # "number" settings have no schema min/max (only "range" does) - clamp
  # here so an out-of-range value can't produce a degenerate grid.
  assign desktop_columns = section.settings.desktop_grid_item_count | at_least: 3 | at_most: 5
  assign tablet_columns = section.settings.tablet_grid_item_count | at_least: 1
  assign mobile_columns = section.settings.mobile_grid_item_count | at_least: 1

  assign mobile_scroll_class = ''
  if section.settings.mobile_display_mode == 'scrollable'
    assign mobile_scroll_class = ' products--scroll'
  endif

  # mobile_padding/margin, max_width, padding: free-form text (not
  # "number"), so any valid CSS value works (e.g. min(1270px, 100% - 104px)
  # for width, or percentage padding) - passed straight through as each
  # custom property's value. `mobile_margin` is overridden by
  # `.products--scroll`'s own fixed margin in scrollable mode.
  assign mobile_padding = section.settings.mobile_padding
  assign mobile_margin = section.settings.mobile_margin
  assign desktop_max_width = section.settings.max_width
  assign desktop_padding = section.settings.padding

  assign background_color = section.settings.background_color
-%}

{%- liquid
  assign product_list = section.settings.product_list
-%}

{%- comment -%}
  Filter & sort (snippets/5dla_filter-sort-drawer.liquid) only makes sense
  against a real collection, so it's suppressed when `product_list` is set.
{%- endcomment -%}
{%- liquid
  assign filter_collection = section.settings.collection | default: collection
-%}

{%- comment -%}
  `c5dla-grid-wrapper`/`c5dla-grid-background` carry the configurable
  background color instead of `.products` itself, since `.products` is
  width-capped/centered (section.settings.max_width) and would look
  narrower than the section on wide screens. Both wrappers get the SAME
  color so there's no visible seam between them.
{%- endcomment -%}
{%- liquid
  assign background_style = ''
  if background_color != blank
    assign background_style = 'background-color: ' | append: background_color | append: ';'
  endif
-%}
<div class="c5dla-grid-wrapper" style="{{ background_style | escape }}">
  {%- if section.settings.filter_sort_enable and product_list == blank and filter_collection != blank -%}
    <div class="c5dla-toolbar">
      <div class="filters">
        <button
          class="filter-button"
          type="button"
          data-c5dla-filter-toggle
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="c5dla-filter-form"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M7 12h10M10 17h4"></path>
          </svg>
          {{ 'products.facets.filter_and_sort' | t }}
        </button>

        {%- render '5dla_filter-sort-genders', results: filter_collection -%}

        <label class="colors-toggle">
          Show all colours
          <input type="checkbox" data-c5dla-colors-toggle>
          <span class="toggle-track"></span>
        </label>
      </div>
    </div>

    {%- render '5dla_filter-sort-drawer',
      results: filter_collection,
      price_range_mode: section.settings.price_range_mode,
      filter_list_mode: section.settings.filter_list_mode
    -%}
  {%- endif -%}

  <div class="c5dla-grid-background" style="{{ background_style | escape }}">
    {%- if product_list and product_list.size > 0 -%}
      {%- paginate product_list by section.settings.page_item -%}
        <section
          class="products{{ mobile_scroll_class }}"
          aria-label="{{ product_list.size }} products"
          style="--c5dla-grid-desktop-columns: {{ desktop_columns }}; --c5dla-grid-tablet-columns: {{ tablet_columns }}; --c5dla-grid-mobile-columns: {{ mobile_columns }}; --c5dla-grid-desktop-max-width: {{ desktop_max_width | escape }}; --c5dla-grid-desktop-padding: {{ desktop_padding | escape }}; --c5dla-grid-mobile-padding: {{ mobile_padding | escape }}; --c5dla-grid-mobile-margin: {{ mobile_margin | escape }};"
        >
          {%- for product in product_list -%}
            {% liquid
              if section.settings.product_card_type == 'card_1'
                render '5dla_product-card-1', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
              elsif section.settings.product_card_type == 'card_2'
                render '5dla_product-card-2', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
              elsif section.settings.product_card_type == 'card_3'
                render '5dla_product-card-3', product: product, swatch_limit: section.settings.swatch_limit, size_limit: section.settings.size_selector_limit, section: section, index: forloop.index
              elsif section.settings.product_card_type == 'card_4'
                render '5dla_product-card-4', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
              elsif section.settings.product_card_type == 'card_5'
                render '5dla_product-card-5', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
              elsif section.settings.product_card_type == 'card_6'
                render '5dla_product-card-6', product: product, swatch_limit: section.settings.swatch_limit, section: section, index: forloop.index
              endif
            %}
          {%- endfor -%}
        </section>
        {{ paginate | default_pagination }}
      {%- endpaginate -%}
    {%- elsif section.settings.collection != blank -%}
      {%- render '5dla_collection-product-grid-paginate',
        target_collection: section.settings.collection,
        desktop_columns: desktop_columns,
        desktop_max_width: desktop_max_width,
        desktop_padding: desktop_padding
      -%}
    {%- elsif collection != blank -%}
      {%- render '5dla_collection-product-grid-paginate',
        target_collection: collection,
        desktop_columns: desktop_columns,
        desktop_max_width: desktop_max_width,
        desktop_padding: desktop_padding
      -%}
    {%- else -%}
      <div class="empty-products">
        {{ 'collections.general.no_matches' | t }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "5DLA Product Grid",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "If set, paginates this collection instead of the page's own collection. Ignored if a product list is set below."
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "info": "If set, renders these products in full (no pagination) instead of a collection."
    },
    {
      "type": "select",
      "id": "product_card_type",
      "label": "Product card style",
      "options": [
        { "value": "card_1", "label": "Card 1" },
        { "value": "card_2", "label": "Card 2" },
        { "value": "card_3", "label": "Card 3" },
        { "value": "card_4", "label": "Card 4" },
        { "value": "card_5", "label": "Card 5" },
        { "value": "card_6", "label": "Card 6" }
      ],
      "default": "card_1"
    },
    {
      "type": "select",
      "id": "mobile_display_mode",
      "label": "Display Mode (mobile)",
      "info": "Scrollable swaps the mobile grid for a horizontally-scrolling row, one card at a time.",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "scrollable", "label": "Scrollable" }
      ],
      "default": "grid"
    },
    {
      "type": "number",
      "id": "desktop_grid_item_count",
      "label": "Columns (desktop)",
      "info": "3-5.",
      "default": 4
    },
    {
      "type": "number",
      "id": "tablet_grid_item_count",
      "label": "Columns (tablet)",
      "default": 3
    },
    {
      "type": "number",
      "id": "mobile_grid_item_count",
      "label": "Columns (mobile)",
      "info": "Ignored when Display Mode (mobile) above is Scrollable.",
      "default": 2
    },
    {
      "type": "text",
      "id": "mobile_padding",
      "label": "Padding (mobile)",
      "info": "Any valid CSS padding shorthand, e.g. 0 9px 53px.",
      "default": "0 9px 53px"
    },
    {
      "type": "text",
      "id": "mobile_margin",
      "label": "Margin (mobile)",
      "info": "Any valid CSS margin shorthand, e.g. 0 auto. Ignored when Display Mode (mobile) above is Scrollable (that layout keeps its own fixed margin).",
      "default": "0 auto"
    },
    {
      "type": "text",
      "id": "max_width",
      "label": "Max width (desktop)",
      "info": "Any valid CSS length, e.g. 1600px or min(1270px, 100% - 104px). Desktop only - ignored on tablet/mobile.",
      "default": "1600px"
    },
    {
      "type": "text",
      "id": "padding",
      "label": "Padding (desktop)",
      "info": "Any valid CSS padding shorthand, e.g. 0 5.15% 85px. Desktop only - tablet/mobile keep their own fixed padding.",
      "default": "0 5.15% 85px"
    },
    {
      "type": "text",
      "id": "background_color",
      "label": "Background Color",
      "info": "Any valid CSS color, e.g. #f7f7f5 or rgba(0,0,0,0.05). Covers the section's full width, not just the (narrower, centered) product grid above. Blank/none by default."
    },
    {
      "type": "range",
      "id": "swatch_limit",
      "label": "Max swatches before \"+N\"",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "number",
      "id": "size_selector_limit",
      "label": "Max sizes before \"+N\" (card 3)",
      "default": 5
    },
    {
      "type": "range",
      "id": "page_item",
      "label": "Products per page",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "number",
      "id": "start_image_lazyload_at",
      "label": "Start Image Lazyload At",
      "info": "Product position (1-based) from which images defer loading until scrolled near the viewport, with a skeleton placeholder shown until then. Earlier products (e.g. the first 4 by default) load their image right away instead, since they're usually already visible on page load.",
      "default": 4
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination style",
      "options": [
        { "value": "loadmore", "label": "Load more button" },
        { "value": "infinite", "label": "Infinite scroll" }
      ],
      "default": "loadmore"
    },
    {
      "type": "header",
      "content": "Filter & Sort"
    },
    {
      "type": "checkbox",
      "id": "filter_sort_enable",
      "label": "Enable filter & sort panel",
      "info": "Only works with a collection (Collection setting above, or the page's own collection) - ignored when Products above is set.",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_list_mode",
      "label": "Filter List Mode",
      "info": "Only applies to list/boolean filters (e.g. Size, Gender, Availability, Color) - ignored by the Price filter.",
      "options": [
        { "value": "column_checkbox", "label": "Column & Checkbox" },
        { "value": "pill_badge", "label": "Pill & Badge" }
      ],
      "default": "column_checkbox"
    },
    {
      "type": "select",
      "id": "price_range_mode",
      "label": "Price Range Mode",
      "options": [
        { "value": "text_box", "label": "Text Box" },
        { "value": "slider", "label": "Slider" }
      ],
      "default": "text_box"
    }
  ],
  "blocks": [
    {
      "type": "custom_badge",
      "name": "Custom Badge",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "bg_color",
          "label": "Background color",
          "info": "Hex color, e.g. #fffffff5 (supports 8-digit hex with alpha - the \"color\" setting type doesn't)."
        },
        {
          "type": "text",
          "id": "text_color",
          "label": "Text color",
          "info": "Hex color, e.g. #fffffff5 (supports 8-digit hex with alpha - the \"color\" setting type doesn't)."
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Show in Products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5DLA Product Grid"
    }
  ]
}
{% endschema %}
